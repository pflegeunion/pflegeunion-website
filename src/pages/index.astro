---
/**
 * Startseite: zwölf Abschnitte gemäss Konzept C1 in der Gestaltung aus
 * Claude Design, Fassung A (Boards Main und Desktop_A_2 mit D01–D13,
 * Mobil_A_1 bis Mobil_A_3 mit M01–M13). Alle Texte wörtlich aus den
 * Boards, von der Geschäftsleitung freigegeben.
 */
import Basis from '../layouts/Basis.astro';
import Hero from '../components/Hero.astro';
import Lohnrechner from '../components/Lohnrechner.astro';
import TrustLeiste from '../components/TrustLeiste.astro';
import Abschnitt from '../components/Abschnitt.astro';
import Karten from '../components/Karten.astro';
import Schritte from '../components/Schritte.astro';
import Bildflaeche from '../components/Bildflaeche.astro';
import Icon from '../components/Icon.astro';
import Hinweiskasten from '../components/Hinweiskasten.astro';
import Demnaechst from '../components/Demnaechst.astro';
import FAQ from '../components/FAQ.astro';
import Anfrage from '../components/Anfrage.astro';

const whatsapp = 'https://wa.me/41417842655?text=Guten%20Tag%2C%20ich%20habe%20eine%20Frage%3A';

const karten = [
  {
    icon: 'banknote',
    titel: 'Fairer Lohn.',
    text: "CHF 37.95 brutto pro Stunde für die geleistete Grundpflege mit Pflegehelferkurs; im ersten Jahr, bis zum Kurs, CHF 33.95 – mit AHV, Unfall- und Krankentaggeldversicherung, Ferienanspruch und ab einem Jahreslohn von CHF 22'680.– auch mit Pensionskasse. Ihre Pflegearbeit zählt, auch für Ihre Altersvorsorge.",
  },
  {
    icon: 'graduation-cap',
    titel: 'Bezahlte Ausbildung.',
    text: 'Sie absolvieren im ersten Jahr berufsbegleitend einen anerkannten Pflegehelferkurs. Wir organisieren ihn und übernehmen die Kosten.',
  },
  {
    icon: 'heart-handshake',
    titel: 'Eine Pflegefachperson an Ihrer Seite.',
    text: 'Eine diplomierte Pflegefachperson leitet Sie an, besucht Sie in den ersten vier Wochen jede Woche zu Hause, danach mindestens einmal im Monat – und ist erreichbar, wenn Sie unsicher sind.',
  },
  {
    icon: 'shield-check',
    titel: 'Vertretung und Sicherheit.',
    text: 'Ferien, Krankheit, eine Pause: Wir organisieren die Vertretung. Werden Sie selbst krank, sind Sie über unsere Krankentaggeldversicherung abgesichert. Die pflegerische Verantwortung liegt bei uns. Verändert sich die Situation, passen wir den Pflegeplan an.',
  },
] as const;

const schritte = [
  {
    titel: 'Erstgespräch.',
    text: 'Sie erzählen, wir hören zu – am Telefon oder bei Ihnen zu Hause. Kostenlos und unverbindlich. Wir melden uns innert 24 Stunden an Werktagen.',
  },
  {
    titel: 'Abklärung zu Hause.',
    text: 'Unsere Pflegefachperson erfasst den Pflegebedarf mit interRAI, dem in der Schweiz anerkannten Instrument. Daraus ergibt sich, wie viele Stunden Grundpflege die Krankenversicherung vergütet.',
  },
  {
    titel: 'Anstellung.',
    text: 'Sie erhalten einen Arbeitsvertrag mit Stundenlohn, Sozialversicherungen und klar geregelten Aufgaben – schriftlich und verständlich. Sie wissen vor der Unterschrift, was Sie verdienen.',
  },
  {
    titel: 'Instruktion und Start.',
    text: 'Ihre Pflegefachperson leitet Sie Schritt für Schritt an: Pflegetechniken, Hygiene, Dokumentation in unserer App, Verhalten im Notfall. Dann starten Sie – mit Rückhalt.',
  },
  {
    titel: 'Lohn und Begleitung.',
    text: 'Ihr Lohn kommt monatlich aufs Konto. Ihre Pflegefachperson bleibt an Ihrer Seite: anfangs wöchentlich, danach mindestens einmal im Monat bei Ihnen zu Hause.',
  },
];

const voraussetzungen = [
  'Sie pflegen eine nahestehende Person, die im Kanton Zug wohnt – als Ehepartner, Tochter, Sohn, Elternteil, Geschwister, Schwiegerkind oder enge Bezugsperson.',
  'Sie sind mindestens 18 Jahre alt. Eine obere Altersgrenze gibt es nicht; auch eine Anstellung im AHV-Alter ist möglich.',
  'Sie verstehen und sprechen Deutsch, damit Instruktion und Dokumentation funktionieren.',
  'Sie sind bereit, im ersten Jahr einen Pflegehelferkurs zu absolvieren. Wir organisieren und bezahlen ihn.',
  'Sie dokumentieren Ihre Einsätze täglich in unserer App. Wir zeigen Ihnen wie – es dauert wenige Minuten.',
  'Die gepflegte Person ist mit dem Vorgehen einverstanden.',
];

const betreuungLeistungen = [
  'Haushalt und Einkauf',
  'Mahlzeiten',
  'Begleitung zu Arzt, Therapie und Behörden',
  'Gesellschaft und Aktivierung',
  'Entlastung für pflegende Angehörige',
];

const personen = [
  { name: 'Michel Gurnari', funktion: 'Geschäftsleitung' },
  { name: 'Cristian Fernandez', funktion: 'Geschäftsleitung' },
  { name: 'Christoph Willi', funktion: 'Pflegedienstleitung, dipl. Pflegefachmann HF' },
];

const fragen = [
  {
    frage: 'Zahlt die Krankenversicherung wirklich, wenn meine Tochter oder mein Mann mich pflegt?',
    antwort:
      'Ja. Wenn wir Ihre Angehörigen anstellen, instruieren und fachlich begleiten, gilt ihre Grundpflege als reguläre Spitex-Leistung. Genau dafür sind wir als Spitex-Organisation vom Kanton Zug bewilligt.',
  },
  {
    frage: 'Kostet das die gepflegte Person etwas?',
    antwort:
      'Den gesetzlichen Eigenanteil von höchstens CHF 15.35 pro Tag – gleich viel wie bei jeder anderen Spitex-Organisation, unabhängig von der Zahl der Pflegestunden. Franchise und Selbstbehalt gelten wie bei jeder medizinischen Leistung. Die Hilflosenentschädigung bleibt bestehen.',
  },
  {
    frage: 'Muss ich dafür meinen Beruf aufgeben?',
    antwort:
      'Nein. Die Anstellung richtet sich nach den anerkannten Pflegestunden – meist ein bis drei Stunden pro Tag – und lässt sich mit Beruf und Familie kombinieren.',
  },
  {
    frage: 'Ich habe keine Pflegeausbildung. Geht das trotzdem?',
    antwort:
      'Ja, genau dafür ist unser Modell gebaut. Sie leisten Grundpflege nach sorgfältiger Instruktion durch Ihre Pflegefachperson und holen den Pflegehelferkurs im ersten Jahr berufsbegleitend nach. Wir bezahlen ihn.',
  },
  {
    frage: 'Ich bin pensioniert. Kann ich trotzdem angestellt werden?',
    antwort:
      'Ja, eine Anstellung im AHV-Alter ist möglich. Der Lohn ist normales Erwerbseinkommen; Sie erhalten einen Lohnausweis für die Steuererklärung.',
  },
  {
    frage: 'Was, wenn die gepflegte Person auch medizinische Pflege braucht?',
    antwort:
      'Medizinische Pflege wie Wundversorgung oder Injektionen bieten wir zurzeit noch nicht selbst an. Im Erstgespräch klären wir mit Ihnen, wer diese Leistungen übernimmt, und stimmen uns ab, damit keine Lücke entsteht.',
  },
  {
    frage: 'Wo ist die Pflegeunion tätig, und wann?',
    antwort:
      'Im ganzen Kanton Zug, in allen elf Gemeinden. Unsere Geschäftsstelle in Rotkreuz ist Mo bis Fr von 08.00 bis 17.00 Uhr erreichbar; Pflegeeinsätze finden täglich zwischen 06.00 und 22.00 Uhr statt. Einen 24-Stunden-Pikettdienst bieten wir nicht an.',
  },
];
---

<Basis
  titel="Pflegende Angehörige anstellen – Lohn, Schulung, Begleitung | Pflegeunion Schweiz, Spitex im Kanton Zug"
  beschreibung="Sie pflegen einen nahestehenden Menschen? Die Pflegeunion stellt Sie an: CHF 37.95 pro Stunde mit Pflegehelferkurs – den Kurs bezahlen wir –, dazu eine Pflegefachperson an Ihrer Seite. Nicht gewinnorientiert, kantonal bewilligt. Lohn in 60 Sekunden berechnen."
>
  <!-- 1 Hero -->
  <Hero
    etikette="CHF 37.95 PRO STUNDE MIT PFLEGEHELFERKURS · SPITEX IM KANTON ZUG"
    titel={['Sie pflegen.', 'Wir stellen Sie dafür an.']}
    text="Sie helfen Ihrer Mutter beim Aufstehen, Ihrem Mann beim Waschen, Ihrem Vater beim Essen – Tag für Tag, meist unbezahlt. Bei der Pflegeunion werden Sie dafür angestellt: mit Lohn, Sozialversicherungen und einer diplomierten Pflegefachperson an Ihrer Seite. Mit Pflegehelferkurs verdienen Sie CHF 37.95 pro Stunde – den Kurs bezahlen wir, bis dahin gelten CHF 33.95."
    primaer={{ text: 'Lohn berechnen', ziel: '#lohnrechner' }}
    sekundaer={{ text: 'Erstgespräch vereinbaren', ziel: '#kontakt' }}
    bild="hero-sohn-vater"
    bildAlt="Ein Sohn kämmt seinem betagten Vater zu Hause die Haare."
  />

  <!-- 2 Lohnrechner (Baustein F, nur die Stundenfrage) -->
  <Lohnrechner anker="lohnrechner" />

  <!-- 3 Trust-Leiste -->
  <TrustLeiste />

  <!-- 4 Was Sie erhalten -->
  <Abschnitt label="Was Sie erhalten" etikette="IHRE ANSTELLUNG BEI DER PFLEGEUNION" titel="Mehr als ein Lohn.">
    <Karten karten={karten} />
  </Abschnitt>

  <!-- 5 So funktioniert es -->
  <Abschnitt
    flaeche="warmgrau"
    anker="ablauf"
    label="So funktioniert es"
    etikette="IN FÜNF SCHRITTEN ZUR ANSTELLUNG"
    titel="Vom ersten Anruf bis zum ersten Lohn."
    seitlich
    inhaltSpalte={6}
  >
    <Schritte name="Vom ersten Anruf bis zum ersten Lohn." schritte={schritte} />
    <p class="knopfzeile ablauf-knopf">
      <a class="button" href="#kontakt">Erstgespräch vereinbaren</a>
    </p>
  </Abschnitt>

  <!-- 6 Passt es? -->
  <Abschnitt label="Passt es?">
    <div class="zweispaltig passt">
      <Bildflaeche
        bild="passt-familie-tisch"
        alt="Eine ältere Frau im Rollstuhl sitzt mit ihrer Familie zu Hause am Tisch und trinkt ein Glas Wasser."
        sizes="(min-width: 1248px) 486px, (min-width: 1024px) calc((100vw - 48px) * 0.4), calc(100vw - 48px)"
        abTablet
        class="passt-bild"
      />
      <div class="passt-text">
        <p class="text-label etikette">PASST ES?</p>
        <h2 class="text-h2">Das sind die Voraussetzungen.</h2>
        <ul class="haken liste-blank">
          {
            voraussetzungen.map((v) => (
              <li>
                <span class="haken-icon">
                  <Icon name="check" />
                </span>
                <span>{v}</span>
              </li>
            ))
          }
        </ul>
        <p class="abschluss">
          Unsicher, ob es bei Ihnen passt? Rufen Sie an oder schreiben Sie uns auf WhatsApp. Wir sagen es
          Ihnen ehrlich – auch wenn die Antwort «nein» ist.
        </p>
        <p class="kontaktzeile text-h3">
          <a href="tel:+41417842655">041 784 26 55</a>
        </p>
        <p class="kontaktzeile kontaktzeile--whatsapp text-h3">
          <a href={whatsapp}>
            <Icon name="message-circle" />
            <span>Auf WhatsApp schreiben</span>
          </a>
        </p>
      </div>
    </div>
  </Abschnitt>

  <!-- 7 Ehrlich gesagt -->
  <Abschnitt flaeche="warmgrau" label="Ehrlich gesagt">
    <Hinweiskasten etikette="EHRLICH GESAGT" titel="Was bezahlt wird – und was nicht." ebene={2} seitlich>
      <div class="ehrlich-absaetze">
        <p>
          <strong>Vergütet wird die Grundpflege:</strong> Hilfe bei Körperpflege, Anziehen, Essen und
          Trinken, Bewegen, Toilettengang. Je nach Situation sind das etwa ein bis drei Stunden pro Tag.
          Wie viele es bei Ihnen sind, zeigt die Abklärung.
        </p>
        <p>
          <strong>Nicht über die Krankenversicherung vergütet</strong> werden Gesellschaft und
          Beaufsichtigung, Nachtpräsenz, Haushalt und Administratives. Das ist gesetzlich geregelt und bei
          allen Anbietern in der Schweiz gleich. Wenn Sie diese Unterstützung brauchen, bieten wir sie als
          Betreuung und Hauswirtschaft an – zu einem festen Stundentarif, den Sie vorher kennen.
        </p>
        <p>
          <strong>Medizinische Pflege</strong> wie Medikamente richten, Wundversorgung oder Injektionen
          bieten wir zurzeit noch nicht an. Braucht die gepflegte Person solche Leistungen, klären wir im
          Erstgespräch mit Ihnen, wer sie übernimmt.
        </p>
        <p>
          <strong>Für die gepflegte Person</strong> ändert sich finanziell wenig: Sie bezahlt den
          gesetzlichen Eigenanteil von höchstens CHF 15.35 pro Tag – gleich viel wie bei jeder anderen
          Spitex-Organisation. Ansprüche wie die Hilflosenentschädigung bleiben bestehen.
        </p>
      </div>
      <hr class="ehrlich-linie" />
      <p class="text-h3 ehrlich-schluss">
        Wir versprechen Ihnen nichts, was wir nicht halten können. Dafür halten wir, was wir
        versprechen.
      </p>
    </Hinweiskasten>
  </Abschnitt>

  <!-- 8 Betreuung & Hauswirtschaft -->
  <Abschnitt label="Betreuung und Hauswirtschaft">
    <div class="zweispaltig betreuung">
      <div class="betreuung-text">
        <p class="text-label etikette">BETREUUNG & HAUSWIRTSCHAFT</p>
        <h2 class="text-h2">Und wenn es mehr braucht als Pflege?</h2>
        <p class="einstieg">
          Ein Einkauf, der zu schwer geworden ist. Ein Mittagessen, das allein nicht schmeckt. Ein
          Arzttermin, zu dem niemand begleiten kann. Ein Nachmittag, an dem Sie selbst einmal durchatmen
          möchten. Unsere Betreuungspersonen kommen ins Haus – als Ergänzung zu Ihrer Pflege oder für
          Haushalte im Kanton Zug, die einfach jemanden brauchen, der regelmässig da ist.
        </p>
        <ul class="haken haken--eng liste-blank">
          {
            betreuungLeistungen.map((l) => (
              <li>
                <span class="haken-icon">
                  <Icon name="check" />
                </span>
                <span>{l}</span>
              </li>
            ))
          }
        </ul>
        <p class="tarif">
          Private Leistung zu einem festen Stundentarif von CHF [XX.–], ohne Zuschläge.
          Ergänzungsleistungen und Zusatzversicherungen können sich beteiligen – wir prüfen das mit
          Ihnen.
        </p>
        <p class="knopfzeile">
          <a class="button button--sekundaer" href="/betreuung-hauswirtschaft/">Betreuung & Hauswirtschaft ansehen</a>
        </p>
      </div>
      <Bildflaeche
        bild="betreuung-kueche"
        alt="Eine Betreuerin und eine ältere Frau bereiten zusammen in der Küche das Essen zu."
        sizes="(min-width: 1248px) 486px, (min-width: 1024px) calc((100vw - 48px) * 0.4), calc(100vw - 48px)"
        abTablet
        class="betreuung-bild"
      />
    </div>
  </Abschnitt>

  <!-- 9 Wer dahintersteht -->
  <Abschnitt flaeche="warmgrau" label="Wer dahintersteht">
    <div class="team">
      <div class="team-text">
        <p class="text-label etikette">ÜBER DIE PFLEGEUNION</p>
        <h2 class="text-h2">Ein Verein, drei Gesichter, ein Versprechen.</h2>
        <p class="einstieg">
          Die Pflegeunion Schweiz ist ein nicht gewinnorientierter Verein mit Sitz in Rotkreuz, gegründet
          2026 von Menschen aus der Spitex, die zwei Dinge zu oft gesehen haben: Angehörige, die längst
          pflegen, aber weder Anleitung noch Anerkennung erhalten – und Pflegefachpersonen, die Formulare
          statt Menschen betreuen. Wir stellen die einen an und entlasten die anderen von der
          Administration. Es gibt keine Aktionäre. Überschüsse bleiben in der Pflege.
        </p>
      </div>
      <ul class="personen liste-blank">
        {
          personen.map((p) => (
            <li class="person">
              <p class="text-h3-verdichtet person-name">{p.name}</p>
              <p class="text-body-verdichtet person-funktion">{p.funktion}</p>
            </li>
          ))
        }
      </ul>
      <p class="knopfzeile team-knopf">
        <a class="button button--sekundaer" href="/ueber-uns/">Mehr über uns</a>
      </p>
    </div>
  </Abschnitt>

  <!-- 10 Demnächst -->
  <Abschnitt label="Demnächst" etikette="WIR BAUEN AUS" titel="Was demnächst dazukommt." abstand="eng">
    <p class="demnaechst-einleitung">
      Wir starten mit dem, was wir heute verlässlich leisten können: der Anstellung und Begleitung
      pflegender Angehöriger sowie Betreuung und Hauswirtschaft. Schritt für Schritt bauen wir unser
      Angebot aus. Diese Leistungen sind in Vorbereitung:
    </p>
    <div class="demnaechst-modul">
      <Demnaechst />
    </div>
    <p class="demnaechst-nachsatz">
      Sie brauchen eine dieser Leistungen schon heute? Rufen Sie uns trotzdem an – wir sagen Ihnen, ab
      wann wir sie anbieten, und nennen Ihnen bis dahin eine Anlaufstelle.
    </p>
  </Abschnitt>

  <!-- 11 Häufige Fragen -->
  <Abschnitt
    flaeche="warmgrau"
    anker="fragen"
    label="Häufige Fragen"
    etikette="HÄUFIGE FRAGEN"
    titel="Kurz beantwortet."
    abstand="mittel"
    seitlich
  >
    <FAQ fragen={fragen} />
  </Abschnitt>

  <!-- 12 Anfrage -->
  <Anfrage titel="Reden wir über Ihre Situation." />
</Basis>

<style>
  /* Buttons mobil in voller Breite, ab 480 px in natürlicher Breite. */
  .knopfzeile {
    margin: var(--space-4) 0 0;
  }

  .knopfzeile .button {
    display: block;
    width: 100%;
  }

  @media (min-width: 480px) {
    .knopfzeile .button {
      display: inline-block;
      width: auto;
    }
  }

  /* So funktioniert es: Button unter dem Text der Schritte. */
  @media (min-width: 1024px) {
    .ablauf-knopf {
      margin-top: calc(var(--space-4) + var(--space-1));
      margin-left: calc(var(--schritt-zahl-spalte) + var(--space-3));
    }
  }

  /* Zweispaltige Abschnitte (Passt es?, Betreuung): mobil Text allein, das
     Bild erscheint ab 768 px (Bildflaeche mit abTablet). */
  .zweispaltig {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  .zweispaltig h2 {
    margin-bottom: 0;
  }

  /* Listen mit Haken: Icon Ocker (nur als Strich), 16 px Abstand zum Text. */
  .haken {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .haken--eng {
    gap: calc(var(--space-1) * 1.5);
    margin-top: var(--space-4);
  }

  .haken li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
  }

  /* Icon mittig zur ersten Zeile (28 px Zeilenhöhe, 24 px Icon). */
  .haken-icon {
    flex: none;
    display: inline-flex;
    margin-top: calc(var(--space-1) / 4);
  }

  /* Ocker nur als Strich des Icons, nie als Schriftfarbe (color). Das Icon
     stammt aus Icon.astro und liegt ausserhalb des Scopes. */
  .haken-icon :global(.icon) {
    stroke: var(--color-ocker);
  }

  .abschluss {
    margin: var(--space-4) 0 0;
    font-weight: 700;
  }

  /* Telefon und WhatsApp in Lato Bold 22 px Tiefblau, Tippfläche 44 px. */
  .kontaktzeile {
    margin: var(--space-1) 0 0;
    color: var(--color-tiefblau);
  }

  .kontaktzeile--whatsapp {
    margin-top: var(--space-2);
  }

  .kontaktzeile a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    vertical-align: top;
    padding-block: calc((var(--tippflaeche) - 1lh) / 2);
    margin-block: calc((1lh - var(--tippflaeche)) / 2);
    white-space: nowrap;
  }

  .einstieg {
    margin: var(--space-2) 0 0;
    max-width: calc(var(--breite-text) - var(--space-4) - var(--space-1));
  }

  .tarif {
    margin: var(--space-3) 0 0;
  }

  /* Ehrlich gesagt: Absätze im Abstand von 24 px, Linie in Tiefblau. */
  .ehrlich-absaetze {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .ehrlich-absaetze p {
    margin: 0;
  }

  .ehrlich-linie {
    height: 0;
    margin: var(--space-4) 0;
    border: 0;
    border-top: 1px solid var(--color-tiefblau);
  }

  .ehrlich-schluss {
    margin: 0;
  }

  /* Wer dahintersteht */
  .team-text h2 {
    margin-bottom: 0;
  }

  .personen {
    margin-top: var(--space-3);
    border-top: 1px solid var(--color-linie);
  }

  .person {
    padding: calc(var(--space-1) * 1.5) 0;
    border-bottom: 1px solid var(--color-linie);
  }

  .person p {
    margin: 0;
  }

  .person-funktion {
    color: var(--color-text-gedaempft);
  }

  /* Demnächst */
  .demnaechst-einleitung {
    max-width: calc(var(--breite-text) - var(--space-4) - var(--space-1));
    margin: 0;
  }

  .demnaechst-modul {
    margin-top: var(--space-4);
  }

  .demnaechst-nachsatz {
    max-width: var(--breite-text);
    margin: var(--space-4) 0 0;
  }

  @media (min-width: 768px) {
    .person {
      padding-block: var(--space-3);
    }

    .person-funktion {
      margin-top: calc(var(--space-1) / 2);
    }
  }

  @media (min-width: 1024px) {
    .haken {
      margin-top: var(--space-4);
    }

    .abschluss {
      margin-top: calc(var(--space-4) + var(--space-1));
    }

    .einstieg {
      margin-top: var(--space-3);
    }

    .tarif {
      margin-top: var(--space-4);
    }

    /* 12-Spalten-Raster wie im Board. */
    .zweispaltig {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-3);
      row-gap: 0;
    }

    /* Passt es?: Bild links (5 Spalten), Text ab Spalte 7. */
    .passt :global(.passt-bild) {
      grid-column: 1 / span 5;
      grid-row: 1;
    }

    .passt-text {
      grid-column: 7 / span 6;
    }

    /* Betreuung: Text 6 Spalten, Bild ab Spalte 8, 32 px tiefer. */
    .betreuung-text {
      grid-column: 1 / span 6;
    }

    .betreuung :global(.betreuung-bild) {
      grid-column: 8 / span 5;
      margin-top: var(--space-4);
    }

    /* Wer dahintersteht: Text und Button 7 Spalten, Personen ab Spalte 9. */
    .team {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
