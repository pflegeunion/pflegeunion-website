---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import bewegungSkript from '../scripts/bewegung.js?raw';

interface Props {
  titel: string;
  beschreibung?: string;
  /** Seite nicht indexieren (interne Seiten wie /bausteine/). */
  noindex?: boolean;
  /** Pfad der kanonischen Adresse, z. B. '/lohnrechner/' (link rel="canonical"). */
  kanonisch?: string;
  /** Beschriftung und Ziel des Primär-Buttons in der Kopfzeile. */
  buttonText?: string;
  buttonZiel?: string;
  /**
   * Bewegung beim Scrollen (Startseite und Unterseiten, global.css «Bewegung»):
   * src/scripts/bewegung.js steht dann inline im Kopf, vor dem ersten
   * Zeichnen der Seite. So ist die Startklasse gesetzt, bevor etwas
   * erscheint (kein Aufblitzen, das Hero-Bild springt nicht), ohne
   * zusätzliche Anfrage, die das Zeichnen aufhält, und Klasse und
   * Beobachtung kommen immer zusammen an.
   */
  bewegung?: boolean;
  /**
   * Zusätzliche Angaben zur schema.org Organization in der Fusszeile, z. B.
   * nonprofitStatus auf Über uns.
   */
  organisation?: Record<string, unknown>;
}

const { titel, beschreibung, noindex = false, kanonisch, buttonText, buttonZiel, bewegung = false, organisation } = Astro.props;
const kanonischeAdresse = kanonisch ? new URL(kanonisch, Astro.site ?? 'https://pflegeunion.ch/').href : undefined;
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {bewegung && <script is:inline set:html={bewegungSkript} />}
    <title>{titel}</title>
    {beschreibung && <meta name="description" content={beschreibung} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {kanonischeAdresse && <link rel="canonical" href={kanonischeAdresse} />}
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link
      rel="preload"
      href="/fonts/lato-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/lato-latin-700-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/playfair-display-latin-700-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <Header buttonText={buttonText} buttonZiel={buttonZiel} />

    <main id="inhalt">
      <slot />
    </main>

    <Footer organisation={organisation} />
  </body>
</html>
