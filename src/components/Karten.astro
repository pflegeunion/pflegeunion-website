---
/**
 * Karten (Konzept C1 Abschnitt 4, B5; Claude Design Fassung A:
 * D04_Erhalten_A, M04_Erhalten_A, M04_Erhalten_offen).
 *
 * Ab 768 px: Raster zwei mal zwei, Karten auf Warmgrau ohne Rahmen, Linien-
 * Icon Ocker (32 px), Kartentitel .text-h3, Text. Keine Buttons.
 * Unter 768 px Mobil-Verdichtung (details/summary, .klappe in global.css):
 * Icon und Kartentitel bleiben sichtbar, der Text klappt aus; Haarlinien
 * zwischen den Karten, Plus/Minus-Icon wie im FAQ.
 *
 * Der Kartentitel steht zweimal im HTML: in der Zeile zum Antippen (mobil)
 * und über dem Text (ab 768 px, immer offen); sichtbar und vorgelesen wird
 * immer nur einer.
 *
 * Mit spalten={3} (Lohnrechner-Seite «So entsteht Ihr Lohn», Claude Design
 * LR_D03_Prinzip, LR_M03_Prinzip): ab 1024 px drei Karten in einer Reihe,
 * 768–1023 px zwei Spalten, die dritte Karte über die ganze Breite.
 *
 * Ohne Icon (Betreuung & Hauswirtschaft «Für wen», Claude Design
 * BH_D03_Fuer_wen, BH_M03_Fuer_wen): mobil nur der Titel in der Zeile zum
 * Antippen, der Text ohne Einzug; ab 768 px Titel und Text. Mit
 * flaeche="weiss" stehen die Karten ab 768 px auf Weiss (Abschnitt auf
 * Warmgrau).
 *
 * Parameter:
 *   karten    Liste { icon?, titel, text }
 *   spalten   2 (Standard, zwei mal zwei) oder 3 (drei in einer Reihe)
 *   flaeche   Fläche der Karten ab 768 px: 'warmgrau' (Standard) oder 'weiss'
 *   bewegung  die Karten blenden beim Scrollen einzeln ein (Startseite und
 *             Unterseiten, global.css «Bewegung»; Standard false)
 */
import Icon, { type IconName } from './Icon.astro';

interface Karte {
  icon?: IconName;
  titel: string;
  text: string;
}

interface Props {
  karten: Karte[];
  spalten?: 2 | 3;
  flaeche?: 'warmgrau' | 'weiss';
  bewegung?: boolean;
}

const { karten, spalten = 2, flaeche = 'warmgrau', bewegung = false } = Astro.props;
---

<ul class:list={['karten', 'liste-blank', { 'karten--drei': spalten === 3 }]}>
  {
    karten.map((k) => (
      <li class:list={['karte', { 'karte--weiss': flaeche === 'weiss', 'karte--ohne-icon': !k.icon }]} data-bewegung={bewegung ? 'kachel' : undefined}>
        <details class="klappe">
          <summary>
            <span class="zeile-kopf">
              {k.icon && (
                <span class="karte-icon">
                  <Icon name={k.icon} groesse={32} />
                </span>
              )}
              <h3 class="text-faq zeile-titel">{k.titel}</h3>
            </span>
            <span class="klappe-icon">
              <Icon name="plus" class="klappe-plus" />
              <Icon name="minus" class="klappe-minus" />
            </span>
          </summary>
          <div class="karte-inhalt">
            {k.icon && (
              <span class="karte-icon offen">
                <Icon name={k.icon} groesse={32} />
              </span>
            )}
            <h3 class="text-h3 karte-titel offen">{k.titel}</h3>
            <p class="karte-text">{k.text}</p>
          </div>
        </details>
      </li>
    ))
  }
</ul>

<style>
  /* Mobil: Liste mit Haarlinien; die Zeile zum Antippen (summary) ist in
     global.css gestaltet (.klappe). */
  .karten {
    border-top: 1px solid var(--color-linie);
  }

  .karte {
    border-bottom: 1px solid var(--color-linie);
  }

  .zeile-kopf {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }

  .zeile-titel {
    margin: 0;
  }

  .karte-icon {
    flex: none;
    display: inline-flex;
  }

  /* Ocker nur als Strich des Icons, nie als Schriftfarbe (color). Das Icon
     stammt aus Icon.astro und liegt ausserhalb des Scopes. */
  .karte-icon :global(.icon) {
    stroke: var(--color-ocker);
  }

  /* Text eingerückt unter den Titel: 32 px Icon plus 16 px Abstand. */
  .karte-text {
    margin: 0;
    padding: 0 0 var(--space-2) var(--space-6);
  }

  /* Ohne Icon: Text ohne Einzug. */
  .karte--ohne-icon .karte-text {
    padding-left: 0;
  }

  .offen {
    display: none;
  }

  /* Ab 768 px: Raster zwei mal zwei, Karten auf Warmgrau, immer offen. */
  @media (min-width: 768px) {
    .karten {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3);
      border-top: 0;
    }

    .karte {
      background-color: var(--color-warmgrau);
      padding: calc(var(--space-4) + var(--space-1));
      border-bottom: 0;
    }

    .karte--weiss {
      background-color: var(--color-weiss);
    }
  }

  /* Drei Karten: 768–1023 px die dritte über die ganze Breite, ab 1024 px
     drei in einer Reihe. */
  @media (min-width: 768px) {
    .karten--drei .karte:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .karten--drei {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .karten--drei .karte:last-child {
      grid-column: auto;
    }
  }

  @supports selector(::details-content) {
    @media (min-width: 768px) {
      .karte-icon.offen {
        display: inline-flex;
      }

      .karte-titel.offen {
        display: block;
        margin: var(--space-3) 0 0;
      }

      .karte--ohne-icon .karte-titel.offen {
        margin-top: 0;
      }

      .karte-text {
        margin-top: calc(var(--space-1) * 1.5);
        padding: 0;
      }
    }
  }
</style>
