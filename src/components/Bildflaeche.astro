---
/**
 * Bildfläche: eckig, festes Seitenverhältnis, ohne Schatten.
 *
 * Mit Foto: `bild` ist der Basisname der WebP-Dateien unter public/bilder/
 * (je 480, 800 und 1200 px breit, z. B. «passt-familie-tisch» für
 * /bilder/passt-familie-tisch-800.webp); die Fläche rendert ein <img> mit
 * srcset und Lazy Loading (Bild im ersten Bildschirm: `prioritaet`).
 * Herkunft und Lizenz der Fotos stehen in LIZENZEN.md. Das Hero-Foto setzt
 * Hero.astro selbst (randabfallend, ohne festes Seitenverhältnis).
 *
 * Ohne Foto zeigt die Fläche Warmgrau mit einem kurzen, gedämpften Text zur
 * Bildidee (Regieanweisung aus dem Konzept). Kein Stockbild, kein Icon als
 * Ersatz.
 *
 * Parameter:
 *   verhaeltnis  '3:2' (Standard) oder '4:3'
 *   bild         Basisname der WebP-Dateien unter public/bilder/
 *   alt          Alternativtext zum Foto
 *   sizes        sizes-Attribut für das srcset (Standard volle Breite)
 *   prioritaet   true für ein Bild im ersten Bildschirm: kein Lazy Loading, hohe Priorität
 *   abTablet     true: unter 768 px weder angezeigt noch geladen
 *   idee         Bildidee als Text für die Platzhalterfläche (ohne Foto)
 *   class        zusätzliche Klassen
 */
interface Props {
  verhaeltnis?: '3:2' | '4:3';
  bild?: string;
  alt?: string;
  sizes?: string;
  prioritaet?: boolean;
  abTablet?: boolean;
  idee?: string;
  class?: string;
}

const {
  verhaeltnis = '3:2',
  bild,
  alt = '',
  sizes = '100vw',
  prioritaet = false,
  abTablet = false,
  idee = '',
  class: klasse,
} = Astro.props;
const [b, h] = verhaeltnis.split(':');

// Breiten der WebP-Dateien; die Vorlagen aus dem Design-Canvas sind 1200 px breit.
const breiten = [480, 800, 1200];
const srcset = bild ? breiten.map((w) => `/bilder/${bild}-${w}.webp ${w}w`).join(', ') : '';

// Leeres 1×1-GIF: unter 768 px wählt der Browser diese Quelle und lädt das Foto nicht.
const leer = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
---

<figure class:list={['bild', { 'bild--ab-tablet': abTablet }, klasse]} style={`--verhaeltnis: ${b} / ${h}`}>
  {
    bild ? (
      <picture>
        {abTablet && <source media="(max-width: 767px)" srcset={leer} />}
        <img
          src={`/bilder/${bild}-800.webp`}
          srcset={srcset}
          sizes={sizes}
          alt={alt}
          width="1200"
          height={Math.round((1200 * Number(h)) / Number(b))}
          loading={prioritaet ? 'eager' : 'lazy'}
          fetchpriority={prioritaet ? 'high' : 'auto'}
          decoding={prioritaet ? 'sync' : 'async'}
        />
      </picture>
    ) : (
      <figcaption class="bild-idee text-small" data-loading={prioritaet ? 'eager' : 'lazy'}>
        {idee}
      </figcaption>
    )
  }
</figure>

<style>
  .bild {
    margin: 0;
    aspect-ratio: var(--verhaeltnis);
    background-color: var(--color-warmgrau);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .bild picture {
    display: contents;
  }

  .bild img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bild-idee {
    margin: 0;
    padding: var(--space-2);
    color: var(--color-text-gedaempft);
  }

  /* Unter 768 px weder angezeigt noch geladen (Quelle oben ist dort leer). */
  .bild--ab-tablet {
    display: none;
  }

  @media (min-width: 768px) {
    .bild--ab-tablet {
      display: flex;
    }
  }
</style>
