---
/**
 * Baustein A – Trust-Leiste (Konzept B4, Claude Design Fassung A: D03_Trust,
 * M03_Trust, Trust_390, Trust_320).
 *
 * Fünf Belege, je ein Linien-Icon (2 px, Ocker) und Text (Lato 16 px,
 * Fast-Schwarz), ohne Silbentrennung. Weisse Fläche, unten eine Haarlinie
 * in Inhaltsbreite. Ab 1024 px eine Zeile; 480–1023 px zwei Spalten, Icon
 * links vom Text; 360–479 px zwei Spalten, Icon über dem Text; unter 360 px
 * eine Spalte, Icon links vom Text.
 * Einsatz: unter dem Lohnrechner der Startseite, über dem Kontaktabschnitt
 * jeder Unterseite.
 *
 * Parameter:
 *   belege  Liste { icon, text }; Standard sind die fünf Belege aus B4
 */
import Icon, { type IconName } from './Icon.astro';

interface Beleg {
  icon: IconName;
  text: string;
}

interface Props {
  belege?: Beleg[];
}

const standard: Beleg[] = [
  { icon: 'shield-check', text: 'Kantonal bewilligte Spitex-Organisation' },
  { icon: 'hand-heart', text: 'Nicht gewinnorientierter Verein' },
  { icon: 'file-check', text: 'Abrechnung über die Krankenversicherung' },
  { icon: 'map-pin', text: 'Tätig im ganzen Kanton Zug' },
  { icon: 'clock', text: 'Antwort innert 24 Stunden an Werktagen' },
];

const { belege = standard } = Astro.props;
---

<section class="trust" aria-label="Belege">
  <div class="trust-inhalt">
    <ul class="trust-liste text-trust">
      {
        belege.map((b) => (
          <li class="beleg">
            <span class="beleg-icon">
              <Icon name={b.icon} />
            </span>
            <span class="beleg-text">{b.text}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .trust {
    background-color: var(--color-weiss);
  }

  /* Oben 40 px Abstand, unten 40 px bis zur Haarlinie. */
  .trust-inhalt {
    max-width: calc(var(--breite-inhalt) + 2 * var(--seitenrand));
    margin: 0 auto;
    padding: calc(var(--space-4) + var(--space-1)) var(--seitenrand) 0;
  }

  .trust-liste {
    margin: 0;
    padding: 0 0 calc(var(--space-4) + var(--space-1));
    list-style: none;
    border-bottom: 1px solid var(--color-linie);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
  }

  .beleg {
    display: flex;
    align-items: flex-start;
    gap: var(--space-1);
    min-width: 0;
  }

  .beleg-text {
    min-width: 0;
    hyphens: none;
    overflow-wrap: normal;
    word-break: normal;
  }

  .beleg-icon {
    flex: none;
    display: inline-flex;
  }

  /* Ocker nur als Strich des Icons, nie als Schriftfarbe (color). Das Icon
     stammt aus Icon.astro und liegt ausserhalb des Scopes. */
  .beleg-icon :global(.icon) {
    stroke: var(--color-ocker);
  }

  /* 360–479 px: zwei Spalten, Icon über dem Text. */
  @media (min-width: 360px) {
    .trust-liste {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3) var(--space-2);
    }

    .beleg {
      flex-direction: column;
    }
  }

  /* 480–1023 px: zwei Spalten, Icon links vom Text. */
  @media (min-width: 480px) {
    .beleg {
      flex-direction: row;
    }
  }

  /* Ab 1024 px: eine Zeile. */
  @media (min-width: 1024px) {
    .trust-liste {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0 var(--space-3);
    }
  }
</style>
