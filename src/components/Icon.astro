export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  groesse?: number;
  class?: string;
}

const { name, groesse = 24, class: klasse } = Astro.props;
const markup = icons[name];
if (!markup) {
  throw new Error(`Icon «${name}» ist in Icon.astro nicht definiert.`);
}
---

<svg
  class:list={['icon', `icon-${name}`, klasse]}
  xmlns="http://www.w3.org/2000/svg"
  width={groesse}
  height={groesse}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={markup}
/>
