---
/**
 * Hero (Konzept C1, Abschnitt 1; Claude Design, Seite «Test Hero warm»:
 * H1b_Desktop, H1b_Mobil, Entscheid GL 24.09.2026). Unterseiten analog.
 *
 * Weisse Fläche. Übertitel, H1 in Playfair (.text-h1: 56 px, unter 768 px
 * 40 px), Text (max. 560 px), Primär- und Sekundär-Button, darunter die
 * Telefonzeile und die WhatsApp-Zeile. Ab 1024 px steht der Text in 7 von
 * 12 Rasterspalten; das Foto liegt rechts ab Rasterspalte 8 randabfallend
 * über die volle Höhe des Abschnitts (bei 1440 px von x = 834 bis zum
 * rechten Rand). Unter 1024 px steht das Foto nach dem Text, randabfallend
 * über die volle Breite, quadratisch und direkt am Abschnittsende. Das Foto
 * ist eckig und füllt die Fläche (object-fit: cover). Mobil: Buttons in
 * voller Breite untereinander.
 *
 * Parameter:
 *   etikette   Übertitel
 *   titel      H1; als Liste werden die Teile mit Zeilenumbruch gesetzt
 *   text       Fliesstext
 *   primaer    { text, ziel } Primär-Button
 *   sekundaer  { text, ziel } Sekundär-Button (optional)
 *   telefon    Telefonzeile anzeigen (Standard true)
 *   whatsapp   WhatsApp-Zeile «Lieber schreiben? Auf WhatsApp» anzeigen (Standard true)
 *   bild       Basisname der WebP-Dateien unter public/bilder/ (je 480, 800
 *              und 1200 px breit, Hochformat 1200 × 1513 px); kein Lazy
 *              Loading, fetchpriority="high"
 *   bildAlt    Alternativtext zum Bild
 *   bildIdee   Text zur Bildidee für die Bildfläche, solange kein Foto vorliegt
 */
import Icon from './Icon.astro';

interface Knopf {
  text: string;
  ziel: string;
}

interface Props {
  etikette: string;
  titel: string | string[];
  text: string;
  primaer: Knopf;
  sekundaer?: Knopf;
  telefon?: boolean;
  whatsapp?: boolean;
  bild?: string;
  bildAlt?: string;
  bildIdee?: string;
}

const {
  etikette,
  titel,
  text,
  primaer,
  sekundaer,
  telefon = true,
  whatsapp = true,
  bild,
  bildAlt = '',
  bildIdee = '',
} = Astro.props;

const titelTeile = Array.isArray(titel) ? titel : [titel];
const whatsappLink = 'https://wa.me/41417842655?text=Guten%20Tag%2C%20ich%20habe%20eine%20Frage%3A';

// Breiten der WebP-Dateien; die Vorlage aus dem Design-Canvas ist 1212 × 1528 px.
const breiten = [480, 800, 1200];
const srcset = bild ? breiten.map((w) => `/bilder/${bild}-${w}.webp ${w}w`).join(', ') : '';
---

<section class="hero" aria-label="Einstieg">
  <div class="hero-inhalt">
    <div class="hero-text">
      <p class="text-label etikette">{etikette}</p>
      <h1 class="text-h1">
        {titelTeile.map((teil, i) => (i === 0 ? teil : [<br />, teil]))}
      </h1>
      <p class="hero-absatz">{text}</p>
      <div class="knoepfe">
        <a class="button" href={primaer.ziel}>{primaer.text}</a>
        {sekundaer && <a class="button button--sekundaer" href={sekundaer.ziel}>{sekundaer.text}</a>}
      </div>
      {
        telefon && (
          <p class="telefon">
            Oder rufen Sie an: <a href="tel:+41417842655">041 784 26 55</a> – Mo bis Fr, 08.00–17.00 Uhr
          </p>
        )
      }
      {
        whatsapp && (
          <p class="whatsapp">
            Lieber schreiben?{' '}
            <a href={whatsappLink}>
              <Icon name="message-circle" groesse={20} />
              <span>Auf WhatsApp</span>
            </a>
          </p>
        )
      }
    </div>
  </div>

  <figure class="hero-bild">
    {
      bild ? (
        <img
          src={`/bilder/${bild}-800.webp`}
          srcset={srcset}
          sizes="(min-width: 1360px) calc(50vw - 114px), (min-width: 1024px) 600px, 100vw"
          alt={bildAlt}
          width="1200"
          height="1513"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
        />
      ) : (
        <figcaption class="bild-idee text-small">{bildIdee}</figcaption>
      )
    }
  </figure>
</section>

<style>
  .hero {
    position: relative;
    background-color: var(--color-weiss);
    overflow: hidden;
  }

  .hero-inhalt {
    max-width: calc(var(--breite-inhalt) + 2 * var(--seitenrand));
    margin: 0 auto;
    padding: calc(var(--space-4) + var(--space-1)) var(--seitenrand) var(--space-6);
  }

  .hero-text h1 {
    margin-bottom: var(--space-3);
  }

  .hero-absatz {
    max-width: var(--breite-hero-text);
    margin-bottom: var(--space-4);
  }

  .knoepfe {
    display: grid;
    gap: var(--space-2);
  }

  .telefon {
    margin: var(--space-3) 0 0;
  }

  .whatsapp {
    margin: var(--space-2) 0 0;
  }

  .telefon a,
  .whatsapp a {
    font-weight: 700;
    white-space: nowrap;
  }

  /* Tippfläche 44 px: 28 px Zeilenhöhe plus je 8 px oben und unten. */
  .telefon a {
    display: inline-block;
    padding-block: var(--space-1);
    margin-block: calc(-1 * var(--space-1));
  }

  .whatsapp a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    vertical-align: top;
    padding-block: var(--space-1);
    margin-block: calc(-1 * var(--space-1));
  }

  /* Foto unter 1024 px: nach dem Text, volle Breite, quadratisch, direkt am
     Abschnittsende (Board H1b_Mobil). Die Vorlage ist ein Hochformat; unten
     ausgerichtet zeigt das Quadrat beide Personen vollständig. */
  .hero-bild {
    margin: 0;
    aspect-ratio: 1 / 1;
    background-color: var(--color-warmgrau);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero-bild img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 100%;
  }

  .bild-idee {
    margin: 0;
    padding: var(--space-2);
    color: var(--color-text-gedaempft);
  }

  @media (min-width: 480px) {
    .knoepfe {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }
  }

  @media (min-width: 768px) {
    .hero-inhalt {
      padding-top: var(--space-8);
    }
  }

  /* Desktop: 12-Spalten-Raster, Text 7 Spalten. Das Foto beginnt an der
     Rasterspalte 8 (Mitte des Abschnitts plus ein Zwölftel von Innenbreite
     und sieben Spaltenabständen; bei 1440 px x = 834) und reicht bis zum
     rechten Rand, über die volle Höhe des Abschnitts (Board H1b_Desktop).
     In der Vorlage (1212 × 1528 px) stehen die beiden Personen mittig und
     reichen von 38 bis 98 % der Höhe. Unten ausgerichtet bleiben sie
     vollständig sichtbar, solange die Fläche höchstens 1,23-mal so breit wie
     hoch ist; auf sehr breiten Bildschirmen (ab etwa 2070 px) wächst der
     Abschnitt deshalb mit der Bildbreite mit (Mindesthöhe 0,81 × Bildbreite). */
  @media (min-width: 1024px) {
    .hero {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: calc(
        (50vw - (min(100vw - 2 * var(--seitenrand), var(--breite-inhalt)) + 7 * var(--space-3)) / 12) * 0.81
      );
    }

    .hero-inhalt {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-3);
      padding-block: var(--abstand-abschnitt);
    }

    .hero-text {
      grid-column: 1 / span 7;
    }

    .hero-text .etikette {
      margin-bottom: var(--space-3);
    }

    .hero-text h1 {
      margin-bottom: var(--space-4);
    }

    .hero-absatz {
      margin-bottom: calc(var(--space-4) + var(--space-1));
    }

    .hero-bild {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      left: calc(50% + (min(100% - 2 * var(--seitenrand), var(--breite-inhalt)) + 7 * var(--space-3)) / 12);
      aspect-ratio: auto;
    }
  }
</style>
