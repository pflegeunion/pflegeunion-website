  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 600 534"
  class:list={['karte-zug', klasse]}
  role="img"
  aria-labelledby="karte-zug-titel"
  data-bewegung={bewegung ? 'text' : undefined}
>
