<style>
  .karte-zug {
    display: block;
    width: 100%;
    height: auto;
  }

  .karte-see {
    fill: var(--color-tiefblau-hell);
    stroke: none;
  }

  .karte-gemeinden path {
    fill: var(--color-weiss);
    stroke: var(--color-linie);
    stroke-width: 1px;
  }

  .karte-umriss {
    fill: none;
    stroke: var(--color-tiefblau);
    stroke-width: 1.5px;
  }

  .karte-gemeinden path,
  .karte-umriss {
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
  }

  /* Namen: Lato Bold 17 Einheiten des viewBox (bei 560 px rund 16 px). */
  .karte-namen text {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 17px;
    fill: var(--color-tiefblau);
    text-anchor: middle;
    dominant-baseline: central;
  }

  /* Unter 640 px zu klein: ausgeblendet, die Etiketten nennen die Gemeinden. */
  @media (max-width: 639px) {
    .karte-namen {
      display: none;
    }
  }
</style>
