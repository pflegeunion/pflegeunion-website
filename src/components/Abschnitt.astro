---
/**
 * Rahmen für jeden Seitenabschnitt (Konzept V3 B5).
 *
 * Fläche weiss oder warmgrau, Innenbreite maximal 1200 px, Abstand
 * --space-8 oben und unten. Etikette und H2 stehen in der Textspalte
 * (maximal 680 px); weiterer Inhalt kommt über den Slot und kann mit der
 * Klasse `textspalte` ebenfalls auf 680 px begrenzt werden.
 *
 * Parameter:
 *   flaeche   'weiss' (Standard) oder 'warmgrau'
 *   anker     id des Abschnitts, z. B. 'ablauf' für /#ablauf
 *   etikette  Übertitel in Versalien (optional)
 *   titel     H2 (optional)
 *   class     zusätzliche Klassen
 */
interface Props {
  flaeche?: 'weiss' | 'warmgrau';
  anker?: string;
  etikette?: string;
  titel?: string;
  class?: string;
}

const { flaeche = 'weiss', anker, etikette, titel, class: klasse } = Astro.props;
---

<section id={anker} class:list={['abschnitt', `abschnitt--${flaeche}`, klasse]}>
  <div class="abschnitt-inhalt">
    {
      (etikette || titel) && (
        <div class="abschnitt-kopf textspalte">
          {etikette && <p class="text-label etikette">{etikette}</p>}
          {titel && <h2 class="text-h2">{titel}</h2>}
        </div>
      )
    }
    <slot />
  </div>
</section>

<style>
  .abschnitt--weiss {
    background-color: var(--color-weiss);
  }

  .abschnitt--warmgrau {
    background-color: var(--color-warmgrau);
  }

  .abschnitt-inhalt {
    max-width: var(--breite-inhalt);
    margin: 0 auto;
    padding: var(--space-8) var(--space-2);
  }

  .abschnitt-kopf {
    margin-bottom: var(--space-4);
  }

  .abschnitt-kopf h2 {
    margin-bottom: 0;
  }

  @media (min-width: 768px) {
    .abschnitt-inhalt {
      padding-inline: var(--space-3);
    }
  }
</style>
