---
/**
 * Baustein F – Lohnrechner (Konzept V3 C1 Abschnitt 2, D1).
 *
 * Warmgrau-Fläche mit Übertitel, H2 und Einleitung, darunter der Rechner auf
 * weisser Fläche: links die Eingaben (Radio-Gruppen mit sichtbaren Labels),
 * rechts das Ergebnis als Live-Region; auf Mobile untereinander.
 *
 * Ohne JavaScript zeigt die Seite die Fallback-Tabelle, Tabelle 2 der
 * Korrektur Lohnrechner vom 22.09.2026 (Auswahl · Monat, mit Kurs · Jahr,
 * mit Kurs · Monat, Einstieg · Jahr, Einstieg), mit Fussnote und Buttons.
 * Unter 640 px steht jede Auswahl als eigener Block mit den vier Werten
 * untereinander, damit die Seite nicht quer scrollt. Das Skript
 * src/scripts/lohnrechner.js blendet `[data-rechner-fallback]` aus und
 * `[data-rechner-ui]` ein.
 *
 * Sätze, Tage, Stundenstufen und Postleitzahlen stehen ausschliesslich im
 * Konfigurationsblock des Skripts (KONFIG); die Fallback-Tabelle wird beim
 * Build aus derselben Rechenlogik erzeugt und gegen die Kontrollwerte aus D1
 * geprüft.
 *
 * Parameter:
 *   anker         id des Abschnitts (Standard 'lohnrechner')
 *   vollstaendig  Vollständige Fassung für die Lohnrechner-Seite (Standard
 *                 false): zusätzlich Frage 3 (Postleitzahl, freiwillig) mit
 *                 den Meldungen aus D1 und der Sekundär-Button «Ergebnis per
 *                 E-Mail erhalten» (vorerst ohne Funktion, folgt mit dem
 *                 Formularversand); der Sekundär-Button «Alle Details zum
 *                 Lohn» entfällt dort.
 */
import Hinweiskasten from './Hinweiskasten.astro';
import { KONFIG, ergebnis, chf, ziffern, stufeFuer } from '../scripts/lohnrechner.js';

interface Props {
  anker?: string;
  vollstaendig?: boolean;
}

const { anker = 'lohnrechner', vollstaendig = false } = Astro.props;

// Vorbelegung gemäss D1: 2 Stunden, «Nein, noch nicht».
const vorbelegung = { stunden: '2', kurs: 'nein' };
const start = ergebnis(stufeFuer(vorbelegung.stunden));

// Spalten der Fallback-Tabelle (Tabelle 2 der Korrektur vom 22.09.2026).
const spalten = [
  { titel: 'Monat, mit Kurs', wert: 'monatMitKurs' },
  { titel: 'Jahr, mit Kurs', wert: 'jahrMitKurs' },
  { titel: 'Monat, Einstieg', wert: 'monatEinstieg' },
  { titel: 'Jahr, Einstieg', wert: 'jahrEinstieg' },
] as const;

// Alle Werte aus derselben Rechenlogik und Konfiguration wie das Skript.
const zeilen = KONFIG.stufen.map((s) => {
  const w = ergebnis(s);
  return {
    text: s.text,
    wert: s.wert,
    werte: spalten.map((sp) => chf(w[sp.wert], w.mehr)),
  };
});

// Kontrollwerte aus Konzept D1, «Ergebniswerte (zur Kontrolle der Umsetzung)»,
// Fassung V3.1 mit 26 Tagen pro Monat (Entscheid GL 22.09.2026, Art. 20 ArG).
// Nur zur Prüfung beim Build; angezeigt werden die berechneten Werte.
const kontrolle = [
  ["rund CHF 990.–", "rund CHF 11'800.–", "rund CHF 880.–", "rund CHF 10'600.–"],
  ["rund CHF 1'480.–", "rund CHF 17'800.–", "rund CHF 1'320.–", "rund CHF 15'900.–"],
  ["rund CHF 1'970.–", "rund CHF 23'700.–", "rund CHF 1'770.–", "rund CHF 21'200.–"],
  ["rund CHF 2'470.–", "rund CHF 29'600.–", "rund CHF 2'210.–", "rund CHF 26'500.–"],
  ["rund CHF 2'960.–", "rund CHF 35'500.–", "rund CHF 2'650.–", "rund CHF 31'800.–"],
  ["über CHF 2'960.–", "über CHF 35'500.–", "über CHF 2'650.–", "über CHF 31'800.–"],
];
zeilen.forEach((z, i) => {
  if (z.werte.join(' / ') !== kontrolle[i].join(' / ')) {
    throw new Error(
      `Lohnrechner: Zeile «${z.text}» ergibt ${z.werte.join(' / ')}, erwartet ${kontrolle[i].join(' / ')}.`,
    );
  }
});

const kursAntworten = [
  { wert: 'nein', text: 'Nein, noch nicht' },
  { wert: 'ja', text: 'Ja' },
];

// Eindeutige Namen und ids je Einsatz der Komponente.
const id = anker;
const nameStunden = `${id}-stunden`;
const nameKurs = `${id}-kurs`;

const satzMitKurs = KONFIG.satzMitKurs.toFixed(2);
const satzEinstieg = KONFIG.satzEinstieg.toFixed(2);

// Fussnote wörtlich aus D1 (Fassung V3.1): sechs Einsatztage pro Woche.
const fussnote =
  `Bruttolohn bei CHF ${satzMitKurs} (mit Pflegehelferkurs) bzw. CHF ${satzEinstieg} (Einstieg) pro Stunde, ` +
  `gerechnet auf sechs Einsatztage pro Woche (${KONFIG.tageProMonat} Tage pro Monat). Ein freier Tag pro Woche ` +
  'ist gesetzlich vorgeschrieben; die Pflege an diesem Tag stellen wir über die Vertretung sicher. ' +
  'Massgebend ist der Pflegebedarf, den unsere Pflegefachperson bei Ihnen zu Hause erfasst. ' +
  'Der definitive Lohn steht in Ihrem Arbeitsvertrag.';
---

<section id={anker} class="rechner-abschnitt">
  <div class="rechner-inhalt">
    <div class="kopf textspalte">
      <p class="text-label etikette">IHR LOHN · IN 60 SEKUNDEN</p>
      <h2 class="text-h2">Was würde ich verdienen?</h2>
      <p>
        Zwei Angaben genügen. Das Ergebnis ist eine Schätzung – verbindlich wird Ihre Zahl nach der
        kostenlosen Abklärung bei Ihnen zu Hause.
      </p>
    </div>

    <div class="rechner" data-rechner data-stunden={nameStunden} data-kurs={nameKurs}>
      <!-- Fallback ohne JavaScript: dieselben Werte als Tabelle (Tabelle 2 der Korrektur vom 22.09.2026). -->
      <div class="fallback" data-rechner-fallback>
        <table>
          <thead>
            <tr>
              <th scope="col">Auswahl</th>
              {spalten.map((sp) => <th scope="col">{sp.titel}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              zeilen.map((z) => (
                <tr>
                  <th scope="row">{z.text}</th>
                  {z.werte.map((w, i) => <td data-spalte={spalten[i].titel}>{w}</td>)}
                </tr>
              ))
            }
          </tbody>
        </table>

        <p class="fussnote text-small textspalte">{fussnote}</p>

        <div class="knoepfe">
          <a class="button" href="#kontakt">Erstgespräch vereinbaren</a>
          {
            !vollstaendig && (
              <a class="button button--sekundaer" href="/lohnrechner/">
                Alle Details zum Lohn
              </a>
            )
          }
        </div>
      </div>

      <!-- Rechner: wird vom Skript eingeblendet. -->
      <div class="ui" data-rechner-ui hidden>
        <div class="eingaben">
          <fieldset class="frage">
            <legend>
              Wie viele Stunden pro Tag helfen Sie bei Körperpflege, Anziehen, Essen, Trinken und
              Bewegen?
            </legend>
            <div class="felder felder--sechs">
              {
                zeilen.map((z) => (
                  <label class="rechner-feld">
                    <input
                      type="radio"
                      name={nameStunden}
                      value={z.wert}
                      checked={z.wert === vorbelegung.stunden}
                    />
                    <span>{z.text}</span>
                  </label>
                ))
              }
            </div>
            <p class="hilfe text-small">
              Zählen Sie nur die Zeit, in der Sie direkt am Menschen helfen. Haushalt, Einkaufen und
              Gesellschaft zählen hier nicht – dazu weiter unten mehr.
            </p>
          </fieldset>

          <fieldset class="frage">
            <legend>Haben Sie einen Pflegehelferkurs abgeschlossen?</legend>
            <div class="felder felder--zwei">
              {
                kursAntworten.map((a) => (
                  <label class="rechner-feld">
                    <input
                      type="radio"
                      name={nameKurs}
                      value={a.wert}
                      checked={a.wert === vorbelegung.kurs}
                    />
                    <span>{a.text}</span>
                  </label>
                ))
              }
            </div>
            <p class="hilfe text-small">
              Mit Kurs verdienen Sie CHF {satzMitKurs} pro Stunde. Noch ohne Kurs starten Sie mit
              CHF {satzEinstieg} und holen den Kurs im ersten Jahr nach – wir bezahlen ihn.
            </p>
          </fieldset>

          {
            vollstaendig && (
              <div class="frage frage--plz">
                <label for={`${id}-plz`}>
                  Postleitzahl der gepflegten Person (freiwillig – wir prüfen, ob wir bei Ihnen im
                  Einsatz sind)
                </label>
                <input
                  type="text"
                  id={`${id}-plz`}
                  inputmode="numeric"
                  autocomplete="postal-code"
                  pattern="[0-9]{4}"
                  maxlength="4"
                  data-plz
                />
              </div>
            )
          }
        </div>

        <div class="ergebnis" aria-live="polite">
          <p class="text-label etikette">IHRE SCHÄTZUNG</p>
          <p class="ergebnis-titel" data-titel>Ihr Lohn nach dem Pflegehelferkurs, den wir bezahlen</p>
          <p class="text-result zahl" aria-hidden="true">
            <span class="text-result-einheit" data-praefix>rund</span>{' '}
            <span class="text-result-einheit">CHF</span>{' '}
            <span data-monat>{ziffern(start.monatMitKurs)}</span><span class="text-result-einheit">.–</span>
          </p>
          <p class="visually-hidden" data-vorlesen></p>
          <p class="zeile-1">brutto pro Monat</p>
          <p>
            Das sind <span data-jahr>{chf(start.jahrMitKurs, start.mehr)}</span> pro Jahr – versichert mit AHV,
            Pensionskasse und Unfallversicherung.
          </p>
          <p data-zeile3>
            Bis zum Kursabschluss im ersten Jahr: <span data-einstieg>{chf(start.monatEinstieg, start.mehr)}</span> pro
            Monat.
          </p>

          <div class="zusatz" data-mehr hidden>
            <Hinweiskasten etikette="WICHTIG" titel="Die Krankenversicherung vergütet die Grundpflege">
              <p>
                Wichtig: Die Krankenversicherung vergütet die Grundpflege, nicht die Präsenz rund um
                die Uhr. Wie viele Stunden bei Ihnen anerkannt werden, zeigt die Abklärung – und im
                Gespräch zeigen wir Ihnen, was zusätzlich möglich ist: Betreuung, Entlastung,
                Hilflosenentschädigung, Ergänzungsleistungen.
              </p>
            </Hinweiskasten>
          </div>

          {
            vollstaendig && (
              <>
                <p class="plz-meldung" data-plz-innerhalb hidden>
                  Wir sind bei Ihnen im Einsatz.
                </p>
                <p class="plz-meldung" data-plz-ausserhalb hidden>
                  Ehrlich gesagt: An diesem Ort sind wir noch nicht im Einsatz. Lassen Sie uns Ihre
                  Kontaktdaten da – wir melden uns, sobald wir Ihre Region erschliessen, und nennen
                  Ihnen auf Wunsch eine Anlaufstelle in Ihrer Nähe.
                </p>
              </>
            )
          }

          <p class="fussnote text-small">{fussnote}</p>

          <div class="knoepfe">
            <a class="button" href="#kontakt" data-erstgespraech>Erstgespräch vereinbaren</a>
            {
              vollstaendig ? (
                <button type="button" class="button button--sekundaer" data-email>
                  Ergebnis per E-Mail erhalten
                </button>
              ) : (
                <a class="button button--sekundaer" href="/lohnrechner/">
                  Alle Details zum Lohn
                </a>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="../scripts/lohnrechner.js"></script>

<style>
  .rechner-abschnitt {
    background-color: var(--color-warmgrau);
  }

  .rechner-inhalt {
    max-width: var(--breite-inhalt);
    margin: 0 auto;
    padding: var(--space-8) var(--space-2);
  }

  .kopf {
    margin-bottom: var(--space-4);
  }

  .kopf h2 {
    margin-bottom: var(--space-2);
  }

  .rechner {
    background-color: var(--color-weiss);
    padding: var(--space-3);
  }

  /* Fallback-Tabelle ohne JavaScript */
  .fallback {
    overflow-x: auto;
  }

  /* Fünf gleich breite Spalten, damit kein Betrag über drei Zeilen bricht. */
  .fallback table {
    table-layout: fixed;
  }

  .fallback th,
  .fallback td {
    hyphens: auto;
    overflow-wrap: break-word;
  }

  /* Unter 640 px: jede Auswahl als Block, die vier Werte untereinander mit
     der Spaltenbezeichnung davor; reicht die Breite nicht, steht der Wert
     ungetrennt unter der Bezeichnung. Der Tabellenkopf bleibt für
     Screenreader. */
  @media (max-width: 639px) {
    .fallback table,
    .fallback tbody,
    .fallback tr,
    .fallback th,
    .fallback td {
      display: block;
    }

    .fallback thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .fallback tbody tr {
      margin-bottom: var(--space-2);
      border: 1px solid var(--color-linie);
    }

    .fallback tbody th,
    .fallback td {
      border: 0;
    }

    .fallback td {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      column-gap: var(--space-2);
      white-space: nowrap;
      border-top: 1px solid var(--color-linie);
    }

    .fallback td::before {
      content: attr(data-spalte);
    }
  }

  .fallback .fussnote {
    margin: var(--space-3) 0 var(--space-4);
  }

  /* Rechner: Eingaben und Ergebnis, auf Mobile untereinander */
  .ui {
    display: grid;
    gap: var(--space-4);
  }

  /* hidden gilt auch für die Grid-Fläche (ohne JavaScript bleibt der Rechner versteckt). */
  .ui[hidden] {
    display: none;
  }

  .frage {
    margin: 0 0 var(--space-4);
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .frage:last-child {
    margin-bottom: 0;
  }

  .frage legend,
  .frage--plz label {
    display: block;
    padding: 0;
    margin-bottom: var(--space-2);
    font-weight: 700;
  }

  /* Auswahlfelder: eckig, 1-px-Rahmen linie, mindestens 56 px hoch;
     Mobile drei mal zwei, Desktop sechs nebeneinander. */
  .felder {
    display: grid;
    gap: var(--space-1);
  }

  .felder--sechs {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .felder--zwei {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .rechner-feld {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tippflaeche-gross);
    padding: var(--space-1);
    border: 1px solid var(--color-linie);
    background-color: var(--color-weiss);
    color: var(--color-schwarz);
    text-align: center;
    font-weight: 700;
    cursor: pointer;
    hyphens: auto;
  }

  /* Der Radio-Button bleibt fokussierbar, sichtbar ist das Feld selbst. */
  .rechner-feld input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    margin: 0;
  }

  .rechner-feld:has(input:checked) {
    background-color: var(--color-tiefblau);
    border-color: var(--color-tiefblau);
    color: var(--color-auf-tiefblau);
  }

  .rechner-feld:has(input:focus-visible) {
    outline: 2px solid var(--color-tiefblau);
    outline-offset: 2px;
  }

  .hilfe {
    margin: var(--space-2) 0 0;
    color: var(--color-text-gedaempft);
  }

  .frage--plz input {
    max-width: calc(var(--space-8) * 2);
  }

  /* Ergebnis */
  .ergebnis {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-linie);
  }

  .ergebnis-titel {
    font-weight: 700;
    margin-bottom: var(--space-1);
  }

  .zahl {
    margin: 0;
  }

  .zeile-1 {
    margin-bottom: var(--space-2);
  }

  .zusatz,
  .plz-meldung {
    margin: var(--space-3) 0;
  }

  .plz-meldung {
    padding: var(--space-2) var(--space-3);
    background-color: var(--color-tiefblau-hell);
  }

  .fussnote {
    margin: var(--space-3) 0 var(--space-4);
    color: var(--color-text-gedaempft);
  }

  .knoepfe {
    display: grid;
    gap: var(--space-2);
  }

  .knoepfe .button {
    text-align: center;
  }

  @media (min-width: 480px) {
    .knoepfe {
      display: flex;
      flex-wrap: wrap;
    }
  }

  @media (min-width: 768px) {
    .rechner-inhalt {
      padding-inline: var(--space-3);
    }

    .rechner {
      padding: var(--space-4);
    }

    .felder--sechs {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .ui {
      grid-template-columns: 7fr 5fr;
      gap: var(--space-6);
      align-items: start;
    }

    .ergebnis {
      padding-top: 0;
      padding-left: var(--space-6);
      border-top: 0;
      border-left: 1px solid var(--color-linie);
    }
  }
</style>
