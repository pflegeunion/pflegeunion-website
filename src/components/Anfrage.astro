---
/**
 * Baustein B – Anfrage-Abschnitt mit Formular (Konzept B4 und D2; Claude
 * Design Fassung A: D12_Anfrage, M12_Anfrage, M12_Anfrage_offen).
 *
 * Tiefblau-Fläche, weisse Schrift. Links Übertitel, H2, Text und die
 * Kontaktangaben (Telefon, E-Mail, WhatsApp); rechts das Formular auf
 * weisser Fläche mit acht Feldern, vier davon Pflicht (Anliegen, Name,
 * Telefon, Postleitzahl und Ort). Steht am Ende jeder Seite unter dem Anker
 * #kontakt. Die linke Spalte trägt .flaeche-tiefblau (Fokusrahmen in
 * --color-auf-tiefblau, global.css).
 *
 * Feld 2 (Pflegehelferkurs) ist nur bei «Anstellung als pflegender
 * Angehöriger» sichtbar, per CSS :has() ohne JavaScript; Browser ohne
 * :has() zeigen es immer. Unter 768 px stehen E-Mail, Erreichbarkeit und
 * Nachricht hinter der Zeile «Weitere Angaben (freiwillig)» (Mobil-
 * Verdichtung, .klappe in global.css); ab 768 px sind sie immer offen.
 *
 * Versand: Das Formular hat noch kein Versandziel; der Versand (Adresse,
 * Eingangsbestätigung, Zeitprüfung) folgt in einem eigenen Pull Request.
 * Honeypot und Zeitstempel sind als Markup vorbereitet; der
 * Bestätigungstext aus D2 liegt als versteckter Block bereit.
 *
 * Fehlerhinweise: Die Pflichtfelder nutzen die HTML-Validierung. Die eigenen
 * deutschen Texte erscheinen ohne JavaScript über :user-invalid, sobald ein
 * Feld verlassen oder das Formular abgeschickt wurde. Fehler als Tiefblau-
 * Fläche mit weisser Schrift, kein Rot.
 *
 * Übergabe aus dem Lohnrechner (D1): Die Zeile `[data-rechner-uebergabe]`
 * über den Feldern ist versteckt; das Rechner-Skript füllt sie beim Klick auf
 * «Erstgespräch vereinbaren», belegt das Anliegen vor und füllt die
 * versteckten Felder stunden und ergebnis. Die Schaltfläche «Entfernen»
 * blendet die Zeile aus und leert die versteckten Werte.
 *
 * Parameter:
 *   titel       H2 (Standard «Reden wir über Ihre Situation.»)
 *   anker       id des Abschnitts (Standard 'kontakt')
 *   quellseite  Wert des versteckten Felds «quellseite» (Standard: aktueller Pfad)
 */
interface Props {
  titel?: string;
  anker?: string;
  quellseite?: string;
}

import Icon from './Icon.astro';

const {
  titel = 'Reden wir über Ihre Situation.',
  anker = 'kontakt',
  quellseite = Astro.url.pathname,
} = Astro.props;

const telefon = { text: '041 784 26 55', href: 'tel:+41417842655' };
const email = 'info@pflegeunion.ch';
const whatsapp = 'https://wa.me/41417842655?text=Guten%20Tag%2C%20ich%20habe%20eine%20Frage%3A';

const anstellung = 'Anstellung als pflegender Angehöriger';
const anliegen = [
  anstellung,
  'Betreuung und Hauswirtschaft',
  'Ich bin Fachperson (Arzt, Spital, Beratungsstelle)',
  'Etwas anderes',
];

const kurs = ['Ja', 'Nein, noch nicht'];
const erreichbar = ['Vormittag', 'Nachmittag', 'Abend'];

// Zeitstempel des Builds. Die Zeitprüfung (Mindestdauer zwischen Aufruf und
// Absenden) wird beim Versand serverseitig festgelegt.
const zeitstempel = new Date().toISOString();
---

<section id={anker} class="anfrage" aria-label="Anfrage">
  <div class="anfrage-inhalt">
    <div class="anfrage-text flaeche-tiefblau">
      <p class="text-label etikette etikette--weiss">
        ERSTGESPRÄCH KOSTENLOS · ANTWORT INNERT 24 STUNDEN
      </p>
      <h2 class="text-h2">{titel}</h2>
      <p class="anfrage-absatz">
        Rufen Sie uns an oder schreiben Sie uns. Wir melden uns innert 24 Stunden an Werktagen. Ein
        Erstgespräch kostet nichts und verpflichtet Sie zu nichts.
      </p>
      <p class="kontakt kontakt-telefon text-h3">
        <a href={telefon.href}>{telefon.text}</a> – Mo bis Fr, 08.00–17.00 Uhr
      </p>
      <p class="kontakt">
        <a href={`mailto:${email}`}>{email}</a>
      </p>
      <p class="kontakt kontakt-whatsapp">
        <a href={whatsapp}>
          <Icon name="message-circle" groesse={20} />
          <span>Auf WhatsApp schreiben</span>
        </a>
      </p>
    </div>

    <form class="formular" method="post" aria-label="Anfrageformular" data-versand="offen">
      <!-- Zeile mit der Schätzung aus dem Lohnrechner; wird vom Rechner-Skript gefüllt. -->
      <div class="uebergabe" data-rechner-uebergabe hidden>
        <p data-uebergabe-text></p>
        <button type="button" class="uebergabe-entfernen">Entfernen</button>
      </div>

      <div class="feld">
        <label for="anfrage-anliegen">Ich interessiere mich für:</label>
        <select id="anfrage-anliegen" name="anliegen" required>
          {anliegen.map((a) => <option value={a}>{a}</option>)}
        </select>
      </div>

      <fieldset class="feld feld--gruppe feld--kurs" aria-describedby="anfrage-kurs-hinweis">
        <legend>Haben Sie einen Pflegehelferkurs abgeschlossen?</legend>
        <div class="optionen">
          {
            kurs.map((k) => (
              <label class="option">
                <input type="radio" name="kurs" value={k} />
                <span>{k}</span>
              </label>
            ))
          }
        </div>
        <p class="hinweis text-small" id="anfrage-kurs-hinweis">
          Ohne Kurs können Sie trotzdem starten – wir bezahlen ihn.
        </p>
      </fieldset>

      <div class="feld">
        <label for="anfrage-name">Vorname und Name</label>
        <input
          type="text"
          id="anfrage-name"
          name="name"
          autocomplete="name"
          required
          aria-describedby="anfrage-name-fehler"
        />
        <p class="fehler" id="anfrage-name-fehler">Bitte geben Sie Ihren Vornamen und Namen an.</p>
      </div>

      <div class="feld">
        <div>
          <label for="anfrage-telefon">Telefon</label>
          <p class="hinweis hinweis--label text-small" id="anfrage-telefon-hinweis">
            Für eine schnelle, persönliche Rückmeldung
          </p>
        </div>
        <input
          type="tel"
          id="anfrage-telefon"
          name="telefon"
          autocomplete="tel"
          required
          aria-describedby="anfrage-telefon-hinweis anfrage-telefon-fehler"
        />
        <p class="fehler" id="anfrage-telefon-fehler">
          Damit wir Sie erreichen können, brauchen wir noch Ihre Telefonnummer.
        </p>
      </div>

      <div class="feld">
        <label for="anfrage-ort">Postleitzahl und Ort der gepflegten Person</label>
        <input
          type="text"
          id="anfrage-ort"
          name="ort"
          autocomplete="postal-code"
          required
          aria-describedby="anfrage-ort-fehler"
        />
        <p class="fehler" id="anfrage-ort-fehler">Bitte geben Sie Postleitzahl und Ort an.</p>
      </div>

      <details class="klappe weitere">
        <summary>
          <span class="text-faq">Weitere Angaben (freiwillig)</span>
          <span class="klappe-icon">
            <Icon name="plus" class="klappe-plus" />
            <Icon name="minus" class="klappe-minus" />
          </span>
        </summary>
        <div class="weitere-inhalt">
          <div class="feld">
            <label for="anfrage-email">E-Mail (freiwillig)</label>
            <input
              type="email"
              id="anfrage-email"
              name="email"
              autocomplete="email"
              aria-describedby="anfrage-email-fehler"
            />
            <p class="fehler" id="anfrage-email-fehler">Bitte prüfen Sie die E-Mail-Adresse.</p>
          </div>

          <fieldset class="feld feld--gruppe">
            <legend>Wann erreichen wir Sie am besten? (freiwillig)</legend>
            <div class="optionen">
              {
                erreichbar.map((zeit) => (
                  <label class="option">
                    <input type="radio" name="erreichbar" value={zeit} />
                    <span>{zeit}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div class="feld">
            <label for="anfrage-nachricht">Ihre Nachricht (freiwillig)</label>
            <textarea id="anfrage-nachricht" name="nachricht" rows="4"></textarea>
          </div>
        </div>
      </details>

      <!-- Versteckte Felder: Übergabe aus dem Lohnrechner, Quellseite, Zeitstempel. -->
      <input type="hidden" name="stunden" value="" />
      <input type="hidden" name="ergebnis" value="" />
      <input type="hidden" name="quellseite" value={quellseite} />
      <input type="hidden" name="zeitstempel" value={zeitstempel} />

      <!-- Honeypot: für Menschen unsichtbar (ausserhalb des sichtbaren Bereichs), für Programme ein normales Feld. -->
      <div class="honeypot" aria-hidden="true">
        <label for="anfrage-webseite">Bitte dieses Feld leer lassen</label>
        <input type="text" id="anfrage-webseite" name="webseite" tabindex="-1" autocomplete="off" />
      </div>

      <p class="datenschutz text-small">
        Bitte keine Gesundheitsangaben in die Nachricht schreiben – diese besprechen wir im Gespräch.
        Ihre Angaben nutzen wir ausschliesslich für die Beantwortung Ihrer Anfrage. Details:{' '}
        <a class="tippflaeche-zeile" href="/datenschutz/">Datenschutzerklärung</a>.
      </p>

      <div>
        <button type="submit" class="button">Anfrage senden</button>
      </div>

      <div class="bestaetigung" hidden>
        <p>
          Vielen Dank. Ihre Anfrage ist bei uns eingegangen. Eine Fachperson meldet sich innert 24
          Stunden an Werktagen bei Ihnen. Wenn es dringend ist:{' '}
          <a href={telefon.href}>{telefon.text}</a>.
        </p>
      </div>
    </form>
  </div>
</section>

<style>
  .anfrage {
    background-color: var(--color-tiefblau);
    color: var(--color-auf-tiefblau);
  }

  .anfrage-inhalt {
    max-width: calc(var(--breite-inhalt) + 2 * var(--seitenrand));
    margin: 0 auto;
    padding: var(--abstand-abschnitt) var(--seitenrand);
    display: grid;
    gap: calc(var(--space-4) + var(--space-1));
  }

  .anfrage-text {
    min-width: 0;
  }

  .anfrage-text h2 {
    margin-bottom: 0;
    color: var(--color-auf-tiefblau);
  }

  .anfrage-text a {
    color: var(--color-auf-tiefblau);
  }

  .etikette--weiss {
    color: var(--color-auf-tiefblau);
  }

  .anfrage-absatz {
    margin: var(--space-3) 0 0;
  }

  /* Kontaktangaben: Links mit Tippfläche 44 px (Zeilenhöhe plus Innenabstand). */
  .kontakt {
    margin: var(--space-2) 0 0;
  }

  .kontakt a {
    display: inline-block;
    padding-block: calc((var(--tippflaeche) - 1lh) / 2);
    margin-block: calc((1lh - var(--tippflaeche)) / 2);
    white-space: nowrap;
  }

  .kontakt-telefon {
    margin-top: var(--space-4);
  }

  .kontakt-whatsapp a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    vertical-align: top;
    font-weight: 700;
  }

  /* Formular auf weisser Fläche, Felder im Abstand von 24 px. */
  .formular {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background-color: var(--color-weiss);
    color: var(--color-schwarz);
    padding: var(--space-3);
  }

  .uebergabe {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    padding: var(--space-2) var(--space-3);
    background-color: var(--color-tiefblau-hell);
  }

  .uebergabe[hidden] {
    display: none;
  }

  .uebergabe p {
    flex: 1 1 20ch;
    margin: 0;
  }

  /* «Entfernen»: Textschaltfläche, Tippfläche 44 px, ohne Fläche. */
  .uebergabe-entfernen {
    flex: none;
    min-height: var(--tippflaeche);
    padding: 0 var(--space-1);
    border: 0;
    background: none;
    color: var(--color-tiefblau);
    font-weight: 700;
    text-decoration: underline;
  }

  .feld {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .feld label,
  .feld legend {
    display: block;
    font-weight: 700;
    padding: 0;
  }

  .feld--gruppe legend {
    margin-bottom: var(--space-1);
  }

  .hinweis {
    margin: 0;
    color: var(--color-text-gedaempft);
  }

  .feld--gruppe .hinweis {
    margin-top: var(--space-1);
  }

  /* Feld 2 nur bei «Anstellung als pflegender Angehöriger» (ohne :has() immer sichtbar). */
  @supports selector(:has(*)) {
    .formular:not(:has(option[value='Anstellung als pflegender Angehöriger']:checked)) .feld--kurs {
      display: none;
    }
  }

  /* Fehlerhinweis: Tiefblau-Fläche mit weisser Schrift, kein Rot. */
  .fehler {
    display: none;
    margin: 0;
    padding: var(--space-1) var(--space-2);
    background-color: var(--color-tiefblau);
    color: var(--color-auf-tiefblau);
  }

  .feld:has(:user-invalid) .fehler {
    display: block;
  }

  .feld:has(:user-invalid) :is(input, select) {
    border-color: var(--color-tiefblau);
    outline: 2px solid var(--color-tiefblau);
    outline-offset: 0;
  }

  .optionen {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
  }

  .option {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--tippflaeche);
    margin: 0;
    font-weight: 400;
    cursor: pointer;
  }

  .feld .option {
    display: inline-flex;
    font-weight: 400;
  }

  /* Weitere Angaben: mobil hinter einer Zeile zum Antippen. */
  .weitere {
    border-top: 1px solid var(--color-linie);
    border-bottom: 1px solid var(--color-linie);
  }

  .weitere-inhalt {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-1) 0 var(--space-2);
  }

  .honeypot {
    position: absolute;
    left: -10000px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .datenschutz {
    margin: 0;
    color: var(--color-text-gedaempft);
  }

  .datenschutz a {
    color: var(--color-link);
  }

  .bestaetigung {
    padding: var(--space-2) var(--space-3);
    background-color: var(--color-tiefblau-hell);
  }

  @media (min-width: 768px) {
    .formular {
      padding: var(--space-6);
    }
  }

  /* Ab 768 px sind die weiteren Angaben immer offen (global.css, .klappe). */
  @supports selector(::details-content) {
    @media (min-width: 768px) {
      .weitere {
        border: 0;
      }

      .weitere-inhalt {
        padding: 0;
      }
    }
  }

  /* Desktop: Text 5 von 12 Spalten, Formular ab Spalte 7. */
  @media (min-width: 1024px) {
    .anfrage-inhalt {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-3);
      align-items: start;
    }

    .anfrage-text {
      grid-column: 1 / span 5;
    }

    .formular {
      grid-column: 7 / span 6;
    }
  }
</style>
