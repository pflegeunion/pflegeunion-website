---
/**
 * Kopfzeile mit Navigation (Konzept B2, Claude Design Fassung A:
 * Kopfzeile_Desktop, Kopfzeile_1280, Kopfzeile_1280_Scroll,
 * Kopfzeile_1440_Scroll, Kopfzeile_Mobil, Trust_320).
 *
 * Ab 1360 px eine Zeile, 72 px, sticky: Logo, fünf Menüpunkte, Telefon,
 * Primär-Button. Darüber die Utility-Zeile (Warmgrau), die wegscrollt.
 *
 * 1024–1359 px zwei Zeilen: Hauptzeile 72 px (Logo, Telefon, Button),
 * darunter die Menüzeile 50 px. Beide bleiben beim Scrollen sichtbar
 * (zusammen 122 px, position: sticky, ohne JavaScript); die Utility-Zeile
 * darüber scrollt weg.
 *
 * Unter 1024 px: Logo (unter 640 px nur das Bildzeichen), Telefon-Icon
 * (Nummer ab 768 px ausgeschrieben), Primär-Button und Burger rechts,
 * Tippflächen 44 × 44 px, keine Utility-Zeile. Unter 360 px stehen die
 * Elemente ohne Zwischenräume und der Button hat 16 px Innenabstand
 * (Board Kopfzeile_Mobil bzw. Trust_320).
 *
 * Primär-Button je Seite (B2): auf der Lohnrechner-Seite «Lohn berechnen» →
 * #rechner (dort erhält der Lohnrechner anker="rechner"), auf Betreuung &
 * Hauswirtschaft «Beratung anfragen» → #kontakt, auf allen anderen Seiten
 * «Lohn berechnen» → /#lohnrechner, auch auf der Startseite.
 *
 * Menü-Skript: neben dem Lohnrechner die einzige zweite Ausnahme vom
 * Verzicht auf JavaScript, inline, unter 1 KB, ohne Framework. Ohne
 * JavaScript bleibt die Navigation sichtbar (unter der Kopfzeile
 * umbrechend) und der Burger verborgen. Das Skript blendet den Burger ein,
 * hält aria-expanded aktuell und schliesst das Menü per Escape-Taste und
 * beim Antippen eines Menüpunkts. `npm test` prüft die Grösse.
 *
 * Parameter:
 *   buttonText  Beschriftung des Primär-Buttons (Standard je Seite, siehe oben)
 *   buttonZiel  Ziel des Primär-Buttons (Standard je Seite, siehe oben)
 *   utility     Utility-Zeile über der Kopfzeile anzeigen (Standard true, ab 1024 px)
 */
import Icon from './Icon.astro';

interface Props {
  buttonText?: string;
  buttonZiel?: string;
  utility?: boolean;
}

// Primär-Button je Seite gemäss B2; der Pfad ohne abschliessenden Schrägstrich.
const pfad = Astro.url.pathname.replace(/\/+$/, '') || '/';
const buttonJeSeite: Record<string, { text: string; ziel: string }> = {
  '/lohnrechner': { text: 'Lohn berechnen', ziel: '#rechner' },
  '/betreuung-hauswirtschaft': { text: 'Beratung anfragen', ziel: '#kontakt' },
};
const standardButton = buttonJeSeite[pfad] ?? { text: 'Lohn berechnen', ziel: '/#lohnrechner' };

const {
  buttonText = standardButton.text,
  buttonZiel = standardButton.ziel,
  utility = true,
} = Astro.props;

const menue = [
  { text: 'So funktioniert es', ziel: '/#ablauf' },
  { text: 'Lohnrechner', ziel: '/lohnrechner/' },
  { text: 'Betreuung & Hauswirtschaft', ziel: '/betreuung-hauswirtschaft/' },
  { text: 'Über uns', ziel: '/ueber-uns/' },
  { text: 'Kontakt', ziel: '#kontakt' },
];

const telefon = { text: '041 784 26 55', href: 'tel:+41417842655' };
const logoAlt = 'Pflegeunion Schweiz – zur Startseite';
---

{
  utility && (
    <div class="utility text-small">
      <p class="utility-inhalt">
        Sie sind Arzt, Spital oder Beratungsstelle? Rufen Sie unsere Pflegedienstleitung an:{' '}
        <a class="tippflaeche-zeile" href={telefon.href}>{telefon.text}</a>
      </p>
    </div>
  )
}

<header class="kopfzeile" id="kopfzeile">
  <div class="kopfzeile-inhalt">
    <a class="logo" href="/">
      <img class="logo-horizontal" src="/logos/logo-horizontal-de.svg" alt={logoAlt} width="242" height="48" />
      <img class="logo-bildzeichen" src="/logos/bildzeichen-farbig.svg" alt={logoAlt} width="48" height="48" />
    </a>

    <nav class="navigation" id="navigation" aria-label="Hauptnavigation">
      <ul class="menue">
        {
          menue.map((punkt) => (
            <li>
              <a class="menue-link text-menu" href={punkt.ziel}>
                {punkt.text}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="menue-telefon" href={telefon.href}>
        <Icon name="phone" />
        {telefon.text}
      </a>
    </nav>

    <a class="telefon" href={telefon.href} aria-label={`Anrufen: ${telefon.text}`}>
      <Icon name="phone" />
      <span class="telefon-nummer">{telefon.text}</span>
    </a>

    <a class="button kopf-button" href={buttonZiel}>{buttonText}</a>

    <button class="burger" type="button" aria-label="Menü öffnen" aria-expanded="false" aria-controls="navigation" hidden>
      <Icon name="menu" class="burger-auf" />
      <Icon name="x" class="burger-zu" />
    </button>
  </div>
</header>

<script is:inline>
  (function () {
    var kopfzeile = document.getElementById('kopfzeile');
    var knopf = kopfzeile && kopfzeile.querySelector('.burger');
    var navigation = document.getElementById('navigation');
    if (!knopf || !navigation) return;
    var offen = false;
    function setzeOffen(wert) {
      offen = wert;
      knopf.setAttribute('aria-expanded', wert);
      kopfzeile.classList.toggle('menue-offen', wert);
    }
    kopfzeile.setAttribute('data-js', '');
    knopf.hidden = false;
    knopf.addEventListener('click', function () {
      setzeOffen(!offen);
    });
    navigation.addEventListener('click', function (ereignis) {
      if (ereignis.target.closest('a')) setzeOffen(false);
    });
    document.addEventListener('keydown', function (ereignis) {
      if (ereignis.key === 'Escape' && offen) {
        setzeOffen(false);
        knopf.focus();
      }
    });
  })();
</script>

<style>
  /* Utility-Zeile: ab 1024 px (nie zusammen mit dem Burger), Warmgrau,
     über der Kopfzeile, scrollt weg. Höhe 40 px: 8 + 24 + 8. */
  .utility {
    display: none;
    background-color: var(--color-warmgrau);
    color: var(--color-schwarz);
  }

  .utility-inhalt {
    max-width: var(--breite-kopfzeile);
    margin: 0 auto;
    padding: var(--space-1) var(--space-3);
    line-height: var(--space-3);
  }

  .utility a {
    font-weight: 700;
    color: var(--color-tiefblau);
  }

  /* Kopfzeile */
  .kopfzeile {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: var(--color-weiss);
    border-bottom: 1px solid var(--color-linie);
  }

  /* Höhe inklusive 1-px-Haarlinie unten: 60 px, ab 768 px 72 px. */
  .kopfzeile-inhalt {
    position: relative;
    max-width: var(--breite-kopfzeile);
    min-height: calc(var(--hoehe-kopfzeile-mobil) - 1px);
    margin: 0 auto;
    padding-inline: var(--space-1);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0;
  }

  /* Logo: Höhe 48 px, verlinkt auf die Startseite. */
  .logo {
    display: inline-flex;
    align-items: center;
    min-height: var(--tippflaeche);
    margin-right: auto;
  }

  .logo-horizontal,
  .logo-bildzeichen {
    display: block;
    height: var(--space-6);
    width: auto;
  }

  /* Unter 640 px nur das Bildzeichen (weniger als 140 px für das Logo frei). */
  .logo .logo-horizontal {
    display: none;
  }

  /* Navigation */
  .navigation {
    display: flex;
    align-items: center;
  }

  .menue {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
  }

  /* Menüpunkte: Lato 18 px, Tiefblau, ohne Unterstreichung. */
  .menue-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tippflaeche);
    color: var(--color-tiefblau);
    text-decoration: none;
    white-space: nowrap;
  }

  .menue-link:hover {
    text-decoration: underline;
  }

  .menue-telefon {
    display: none;
  }

  /* Telefon: Icon mit Tippfläche 44 × 44 px, ab 768 px mit Nummer in Lato Bold Tiefblau. */
  .telefon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    min-height: var(--tippflaeche);
    min-width: var(--tippflaeche);
    font-weight: 700;
    color: var(--color-tiefblau);
    text-decoration: none;
    white-space: nowrap;
  }

  .telefon-nummer {
    display: none;
  }

  .kopf-button {
    white-space: nowrap;
  }

  /* Burger rechts, Tippfläche 44 × 44 px, eigene Darstellung statt des Primär-Buttons. */
  .burger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tippflaeche);
    height: var(--tippflaeche);
    min-height: var(--tippflaeche);
    padding: 0;
    border: 0;
    border-radius: var(--radius-none);
    background-color: transparent;
    color: var(--color-tiefblau);
  }

  /* Ohne JavaScript bleibt der Burger verborgen (Attribut hidden); die
     Button-Regel in global.css würde ihn sonst einblenden. */
  .burger[hidden] {
    display: none;
  }

  /* Die Icons stammen aus Icon.astro und liegen ausserhalb des Scopes. */
  .burger :global(.burger-zu),
  .menue-offen .burger :global(.burger-auf) {
    display: none;
  }

  .menue-offen .burger :global(.burger-zu) {
    display: block;
  }

  /* Unter 1024 px: Navigation ohne JavaScript unter der Kopfzeile, mit
     JavaScript hinter dem Burger. */
  @media (max-width: 1023px) {
    .navigation {
      order: 10;
      flex-basis: 100%;
      padding-block: var(--space-1) var(--space-2);
    }

    .kopfzeile[data-js] .navigation {
      display: none;
    }

    .kopfzeile[data-js].menue-offen .navigation {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      padding: var(--space-3) var(--seitenrand) var(--space-4);
      background-color: var(--color-weiss);
      border-bottom: 1px solid var(--color-linie);
    }

    .kopfzeile[data-js] .menue {
      flex-direction: column;
      gap: 0;
    }

    /* Geöffnetes Mobilmenü: Lato Bold 24 px (B2, .text-menu). */
    .kopfzeile[data-js] .menue-link {
      display: flex;
      padding-block: var(--space-1);
    }

    .kopfzeile[data-js] .menue-telefon {
      display: inline-flex;
      align-items: center;
      gap: var(--space-1);
      min-height: var(--tippflaeche);
      margin-top: var(--space-3);
      font-weight: 700;
      color: var(--color-tiefblau);
      text-decoration: none;
    }
  }

  /* Ohne JavaScript und in der Desktop-Navigation: Menüpunkte in
     Fliesstextgrösse (Lato 18 px), nicht 24 px. */
  .kopfzeile:not([data-js]) .menue-link {
    font-size: inherit;
    line-height: inherit;
    font-weight: 400;
  }

  /* Unter 360 px: ohne Zwischenräume, Button-Innenabstand 16 px (Trust_320). */
  @media (max-width: 359px) {
    .kopf-button {
      padding-inline: var(--space-2);
    }
  }

  /* Ab 360 px: Zwischenräume 8 px (Kopfzeile_Mobil). */
  @media (min-width: 360px) {
    .kopfzeile-inhalt {
      gap: var(--space-1);
    }
  }

  @media (min-width: 480px) {
    .kopfzeile-inhalt {
      padding-inline: var(--space-2);
    }
  }

  @media (min-width: 640px) {
    .logo .logo-horizontal {
      display: block;
    }

    .logo .logo-bildzeichen {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .kopfzeile-inhalt {
      min-height: calc(var(--hoehe-kopfzeile) - 1px);
      padding-inline: var(--space-3);
      gap: var(--space-2);
    }

    .telefon-nummer {
      display: inline;
    }
  }

  /* 1024–1359 px: zwei Zeilen, Hauptzeile 72 px ohne Unterkante, darunter
     die Menüzeile 50 px mit Haarlinie oben und unten; beide sticky. */
  @media (min-width: 1024px) {
    .utility {
      display: block;
    }

    .burger {
      display: none;
    }

    .kopfzeile {
      border-bottom: 0;
    }

    .kopfzeile-inhalt {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto auto;
      grid-template-rows: var(--hoehe-kopfzeile) var(--hoehe-menuezeile);
      column-gap: var(--space-2);
      row-gap: 0;
      min-height: 0;
    }

    .logo {
      grid-row: 1;
      grid-column: 1;
      justify-self: start;
    }

    .telefon {
      grid-row: 1;
      grid-column: 2;
    }

    .kopf-button {
      grid-row: 1;
      grid-column: 3;
    }

    .navigation {
      grid-row: 2;
      grid-column: 1 / -1;
      margin-inline: calc(-1 * var(--space-3));
      padding-inline: var(--space-3);
      border-top: 1px solid var(--color-linie);
      border-bottom: 1px solid var(--color-linie);
    }

    .menue {
      flex-wrap: nowrap;
      gap: 0 var(--space-4);
    }

    .menue-link {
      font-size: inherit;
      line-height: inherit;
      font-weight: 400;
    }
  }

  /* Ab 1360 px: eine Zeile, Menü zwischen Logo und Telefon. */
  @media (min-width: 1360px) {
    .kopfzeile {
      border-bottom: 1px solid var(--color-linie);
    }

    .kopfzeile-inhalt {
      display: flex;
      flex-wrap: nowrap;
      min-height: calc(var(--hoehe-kopfzeile) - 1px);
      gap: var(--space-3);
    }

    .navigation {
      margin-inline: 0;
      padding-inline: 0;
      border: 0;
    }

    .menue {
      gap: 0 var(--space-2);
    }
  }
</style>
