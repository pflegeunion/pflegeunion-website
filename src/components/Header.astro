---
/**
 * Kopfzeile mit Navigation (Konzept V3 B2) und Utility-Zeile.
 *
 * Sticky, 72 px Desktop / 60 px Mobile, weisse Fläche mit Haarlinie unten.
 * Logo links (horizontales Logo DE, unter 480 px Breite nur das Bildzeichen),
 * fünf Menüpunkte, Telefon, Primär-Button. Unterhalb von 1360 px ein
 * Burger-Menü; Telefon und Button bleiben ausserhalb des Menüs sichtbar.
 * Die Desktop-Navigation braucht rund 1310 px (Logo, fünf Punkte in 18 px,
 * Telefon, Button), deshalb ist die Kopfzeile bis --breite-kopfzeile breit
 * und die Utility-Zeile erscheint ab 1024 px.
 *
 * Das Burger-Menü ist das einzige JavaScript der Webseite. Ohne JavaScript
 * bleibt die Navigation sichtbar (unter der Kopfzeile umbrechend).
 *
 * Parameter:
 *   buttonText  Beschriftung des Primär-Buttons (Standard «Lohn berechnen»)
 *   buttonZiel  Ziel des Primär-Buttons (Standard /#lohnrechner)
 *   utility     Utility-Zeile über der Kopfzeile anzeigen (Standard true, nur Desktop)
 */
import Icon from './Icon.astro';

interface Props {
  buttonText?: string;
  buttonZiel?: string;
  utility?: boolean;
}

const {
  buttonText = 'Lohn berechnen',
  buttonZiel = '/#lohnrechner',
  utility = true,
} = Astro.props;

const menue = [
  { text: 'So funktioniert es', ziel: '/#ablauf' },
  { text: 'Lohnrechner', ziel: '/lohnrechner/' },
  { text: 'Betreuung & Hauswirtschaft', ziel: '/betreuung-hauswirtschaft/' },
  { text: 'Über uns', ziel: '/ueber-uns/' },
  { text: 'Kontakt', ziel: '#kontakt' },
];

const telefon = { text: '041 784 26 55', href: 'tel:+41417842655' };
---

{
  utility && (
    <div class="utility text-small">
      <p class="utility-inhalt">
        Sie sind Arzt, Spital oder Beratungsstelle? Rufen Sie unsere Pflegedienstleitung an:{' '}
        <a href={telefon.href}>{telefon.text}</a>
      </p>
    </div>
  )
}

<header class="kopfzeile" id="kopfzeile">
  <div class="kopfzeile-inhalt">
    <a class="logo" href="/">
      <img
        class="logo-horizontal"
        src="/logos/logo-horizontal-de.svg"
        alt="Pflegeunion Schweiz, zur Startseite"
        width="242"
        height="48"
      />
      <img
        class="logo-bildzeichen"
        src="/logos/bildzeichen-farbig.svg"
        alt="Pflegeunion Schweiz, zur Startseite"
        width="48"
        height="48"
      />
    </a>

    <nav class="navigation" id="navigation" aria-label="Hauptnavigation">
      <ul class="menue">
        {
          menue.map((punkt) => (
            <li>
              <a class="menue-link text-menu" href={punkt.ziel}>
                {punkt.text}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="menue-telefon" href={telefon.href}>
        <Icon name="phone" />
        {telefon.text}
      </a>
    </nav>

    <a class="telefon" href={telefon.href}>
      <Icon name="phone" />
      <span class="telefon-nummer">{telefon.text}</span>
    </a>

    <a class="button" href={buttonZiel}>{buttonText}</a>

    <button class="burger" type="button" aria-expanded="false" aria-controls="navigation" hidden>
      <Icon name="menu" class="burger-auf" />
      <Icon name="x" class="burger-zu" />
      <span class="visually-hidden">Menü</span>
    </button>
  </div>
</header>

<script is:inline>
  // Burger-Menü: einziges JavaScript der Webseite. Ohne JavaScript bleibt
  // die Navigation sichtbar; erst mit JavaScript wird sie auf Mobile
  // hinter dem Burger verborgen.
  (function () {
    var kopfzeile = document.getElementById('kopfzeile');
    var knopf = kopfzeile.querySelector('.burger');
    var navigation = document.getElementById('navigation');
    if (!kopfzeile || !knopf || !navigation) return;

    kopfzeile.setAttribute('data-js', '');
    knopf.hidden = false;

    function setzeOffen(offen) {
      knopf.setAttribute('aria-expanded', offen ? 'true' : 'false');
      kopfzeile.classList.toggle('menue-offen', offen);
    }

    function istOffen() {
      return knopf.getAttribute('aria-expanded') === 'true';
    }

    knopf.addEventListener('click', function () {
      setzeOffen(!istOffen());
    });

    navigation.addEventListener('click', function (ereignis) {
      if (ereignis.target.closest('a')) setzeOffen(false);
    });

    document.addEventListener('keydown', function (ereignis) {
      if (ereignis.key === 'Escape' && istOffen()) {
        setzeOffen(false);
        knopf.focus();
      }
    });

    document.addEventListener('click', function (ereignis) {
      if (istOffen() && !kopfzeile.contains(ereignis.target)) setzeOffen(false);
    });
  })();
</script>

<style>
  /* Utility-Zeile: nur Desktop, Warmgrau, über der Kopfzeile. */
  .utility {
    display: none;
    background-color: var(--color-warmgrau);
    color: var(--color-schwarz);
  }

  .utility-inhalt {
    max-width: var(--breite-kopfzeile);
    margin: 0 auto;
    padding: var(--space-1) var(--space-3);
  }

  .utility a {
    font-weight: 700;
    color: var(--color-tiefblau);
  }

  /* Kopfzeile */
  .kopfzeile {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: var(--color-weiss);
    border-bottom: 1px solid var(--color-linie);
  }

  .kopfzeile-inhalt {
    position: relative;
    max-width: var(--breite-kopfzeile);
    min-height: var(--hoehe-kopfzeile-mobil);
    margin: 0 auto;
    padding-inline: var(--space-2);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  /* Logo: Höhe 48 px, verlinkt auf die Startseite. */
  .logo {
    display: inline-flex;
    align-items: center;
    min-height: var(--tippflaeche);
    margin-right: auto;
  }

  .logo-horizontal,
  .logo-bildzeichen {
    display: block;
    height: var(--space-6);
    width: auto;
  }

  /* Unter 480 px Breite nur das Bildzeichen (Mindestbreite des Logos 140 px). */
  .logo .logo-horizontal {
    display: none;
  }

  /* Navigation */
  .navigation {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .menue {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
  }

  .menue-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tippflaeche);
    color: var(--color-tiefblau);
    text-decoration: none;
  }

  .menue-link:hover {
    text-decoration: underline;
  }

  .menue-telefon {
    display: none;
  }

  /* Telefon: Lato Bold Tiefblau, Icon plus Nummer. */
  .telefon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    min-height: var(--tippflaeche);
    min-width: var(--tippflaeche);
    font-weight: 700;
    color: var(--color-tiefblau);
    text-decoration: none;
    white-space: nowrap;
  }

  /* Burger: eigene Darstellung statt des Primär-Buttons. */
  .burger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tippflaeche);
    height: var(--tippflaeche);
    min-height: var(--tippflaeche);
    padding: 0;
    border: 0;
    border-radius: var(--radius-none);
    background-color: transparent;
    color: var(--color-tiefblau);
  }

  /* Die Icons stammen aus Icon.astro und liegen ausserhalb des Scopes. */
  .burger :global(.burger-zu),
  .menue-offen .burger :global(.burger-auf) {
    display: none;
  }

  .menue-offen .burger :global(.burger-zu) {
    display: block;
  }

  /* Mobile: Navigation ohne JavaScript unter der Kopfzeile, mit JavaScript
     hinter dem Burger. */
  @media (max-width: 1359px) {
    .navigation {
      order: 10;
      flex-basis: 100%;
      padding-block: var(--space-1) var(--space-2);
    }

    .kopfzeile[data-js] .navigation {
      display: none;
    }

    .kopfzeile[data-js].menue-offen .navigation {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      padding: var(--space-3) var(--space-2) var(--space-4);
      background-color: var(--color-weiss);
      border-bottom: 1px solid var(--color-linie);
    }

    .kopfzeile[data-js] .menue {
      flex-direction: column;
      gap: 0;
    }

    .kopfzeile[data-js] .menue-link {
      display: flex;
      padding-block: var(--space-1);
    }

    .kopfzeile[data-js] .menue-telefon {
      display: inline-flex;
      align-items: center;
      gap: var(--space-1);
      min-height: var(--tippflaeche);
      margin-top: var(--space-3);
      font-weight: 700;
      color: var(--color-tiefblau);
      text-decoration: none;
    }
  }

  /* Ohne JavaScript: Menüpunkte in Fliesstextgrösse, nicht 24 px. */
  .kopfzeile:not([data-js]) .menue-link {
    font-size: inherit;
    line-height: inherit;
    font-weight: 400;
  }

  /* Sehr schmale Geräte: engerer Rand, Telefonnummer nur für Screenreader,
     Icon bleibt sichtbar. */
  @media (max-width: 479px) {
    .kopfzeile-inhalt {
      padding-inline: var(--space-1);
    }

    .kopfzeile[data-js].menue-offen .navigation {
      padding-inline: var(--space-2);
    }

    .telefon-nummer {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }

  @media (min-width: 480px) {
    .logo .logo-horizontal {
      display: block;
    }

    .logo .logo-bildzeichen {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .kopfzeile-inhalt {
      min-height: var(--hoehe-kopfzeile);
      padding-inline: var(--space-3);
      gap: var(--space-3);
    }
  }

  /* Utility-Zeile ab Tablet quer. */
  @media (min-width: 1024px) {
    .utility {
      display: block;
    }
  }

  /* Desktop-Navigation in einer Zeile */
  @media (min-width: 1360px) {
    .kopfzeile-inhalt {
      flex-wrap: nowrap;
    }

    .navigation {
      order: 0;
      flex-basis: auto;
      padding-block: 0;
    }

    .menue {
      flex-wrap: nowrap;
      gap: 0 var(--space-2);
    }

    .menue-link {
      white-space: nowrap;
    }

    .menue-link {
      font-size: inherit;
      line-height: inherit;
      font-weight: 400;
    }

    .burger {
      display: none;
    }
  }
</style>
