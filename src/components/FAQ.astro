---
/**
 * Baustein E – FAQ (Konzept B4; Claude Design Fassung A: D11_FAQ, M11_FAQ).
 *
 * Akkordeon mit details/summary auf allen Breiten: Frage als H3 in Lato Bold
 * 20 px Tiefblau (.text-faq), Antwort 18 px (max. 680 px), Haarlinie
 * zwischen den Einträgen, Plus/Minus-Icon rechts. Die erste Frage ist
 * geöffnet (wie im Board). Alle Antworten stehen im HTML. Öffnet weich,
 * respektiert prefers-reduced-motion. Dieselben Daten werden als schema.org
 * FAQPage (JSON-LD) ausgegeben.
 *
 * Parameter:
 *   fragen      Liste { frage, antwort }; die Antwort ist Text ohne HTML
 *   ersteOffen  erste Frage geöffnet (Standard true)
 */
import Icon from './Icon.astro';

interface Frage {
  frage: string;
  antwort: string;
}

interface Props {
  fragen: Frage[];
  ersteOffen?: boolean;
}

const { fragen, ersteOffen = true } = Astro.props;

const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: fragen.map((f) => ({
    '@type': 'Question',
    name: f.frage,
    acceptedAnswer: { '@type': 'Answer', text: f.antwort },
  })),
};
---

<div class="faq">
  {
    fragen.map((f, i) => (
      <details class="eintrag" open={ersteOffen && i === 0}>
        <summary class="frage">
          <h3 class="text-faq frage-text">{f.frage}</h3>
          <span class="frage-icon">
            <Icon name="plus" class="icon-plus" />
            <Icon name="minus" class="icon-minus" />
          </span>
        </summary>
        <div class="antwort">
          <p>{f.antwort}</p>
        </div>
      </details>
    ))
  }
  <script type="application/ld+json" set:html={JSON.stringify(faqPage)} />
</div>

<style>
  .faq {
    border-top: 1px solid var(--color-linie);
  }

  .eintrag {
    border-bottom: 1px solid var(--color-linie);
  }

  .frage {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: var(--tippflaeche);
    padding-block: calc(var(--space-2) + var(--space-1) / 2);
    list-style: none;
    cursor: pointer;
  }

  .frage::-webkit-details-marker {
    display: none;
  }

  .frage-text {
    margin: 0;
  }

  /* Icon mittig zur ersten Zeile der Frage (28 px Zeilenhöhe, 24 px Icon). */
  .frage-icon {
    flex: none;
    display: inline-flex;
    margin-top: calc(var(--space-1) / 4);
    color: var(--color-tiefblau);
  }

  /* Die Icons stammen aus Icon.astro und liegen ausserhalb des Scopes. */
  .eintrag[open] :global(.icon-plus),
  .eintrag:not([open]) :global(.icon-minus) {
    display: none;
  }

  .antwort {
    max-width: var(--breite-text);
    padding-bottom: calc(var(--space-2) + var(--space-1) / 2);
  }

  .eintrag[open] .antwort {
    animation: faq-oeffnen 200ms ease-out;
  }

  @keyframes faq-oeffnen {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .eintrag[open] .antwort {
      animation: none;
    }
  }

  @media (min-width: 768px) {
    .frage {
      padding-block: var(--space-3);
    }

    .antwort {
      padding-bottom: var(--space-3);
    }
  }
</style>
